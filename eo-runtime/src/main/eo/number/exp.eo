# Returns Euler's number raised to the power of a `num`.
# An argument above `710` answers `pinf` and one below `-750` answers zero,
# without asking `power` at all. Beyond those two bounds the answer is out of
# the range a double holds anyway, while `power` walks the exponent down by
# halves, one step per binary digit, and a magnitude of the order of `1e308`
# takes more than a thousand of them, which is deeper than the stack goes.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package number
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^] > exp
  if. > @
    ^.gt 710
    pinf
    if.
      ^.lt -750
      0
      e.power ^

  -1.0e308.exp.eq 0 ++> can-exponentiate-a-huge-negative-argument

  1.0e308.exp.eq pinf ++> can-exponentiate-a-huge-positive-argument

  lt. ++> can-exponentiate-five
    abs.
      minus.
        e.power 5
        5.exp
    1.0e-7

  709.exp.is-finite ++> can-exponentiate-just-below-the-upper-bound

  lt. ++> can-exponentiate-minus-one
    abs.
      minus.
        1.div e
        -1.exp
    1.0e-8

  lt. ++> can-exponentiate-minus-ten
    abs.
      minus.
        e.power -10
        -10.exp
    1.0e-12

  ninf.exp.eq 0 ++> can-exponentiate-negative-infinity

  lt. ++> can-exponentiate-one
    abs.
      e.minus 1.exp
    1.0e-8

  pinf.exp.eq pinf ++> can-exponentiate-positive-infinity

  nan.exp.is-nan ++> can-return-nan-when-exponentiating-nan
