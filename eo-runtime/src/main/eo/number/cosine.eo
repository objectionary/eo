# Cosine of the angle in radians as `org.eolang.number`, taken from the sine
# of the half angle, since cos(x) equals one less twice the square of
# sin(x/2).
#
# The obvious route, sin(x + pi/2), cannot be taken: a quarter turn added to
# a large angle is lost in the rounding of the sum, and at `1e15`, where a
# double steps by an eighth, the shift moves the argument by more than the
# answer is worth. Halving an angle is exact for every double, so the half
# angle route hands `sine` a number it can reduce as accurately as the
# original.
#
# The price is the square: where the cosine is near zero the two terms of the
# subtraction are near equal and their leading digits cancel, so the answer
# keeps its absolute accuracy and not its relative one. Zero is not such a
# place: sin(0) is exactly zero, so the unit value comes out exact without
# being asked for.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package number
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^] > cosine
  1.minus > @
    2.times
      half.times half
  sine. > half
    ^.div 2

  lt. ++> can-behave-as-an-even-function
    abs.
      times.
        minus.
          cosine.
            pi.div 3
          cosine. (pi.div 3).neg
        1000
    1

  lt. ++> can-reduce-a-large-angle-when-taking-cosine
    abs.
      minus.
        times.
          cosine.
            plus.
              pi.times 10
              pi.div 3
          1000
        500
    1

  nan.cosine.is-nan ++> can-return-nan-for-a-cosine-of-nan

  ninf.cosine.is-nan ++> can-return-nan-for-a-cosine-of-negative-infinity

  pinf.cosine.is-nan ++> can-return-nan-for-a-cosine-of-positive-infinity

  lt. ++> can-take-a-cosine-of-a-hundred-million
    abs.
      100000000.cosine.minus -0.3633850893556905
    1.0e-14

  lt. ++> can-take-a-cosine-of-a-million
    abs.
      1000000.cosine.minus 0.9367521275331447
    1.0e-14

  lt. ++> can-take-a-cosine-of-a-quadrillion
    abs.
      1000000000000000.cosine.minus -0.5131937377869703
    1.0e-14

  lt. ++> can-take-a-cosine-of-pi
    abs.
      minus.
        pi.cosine.times 1000
        -1000
    1

  lt. ++> can-take-a-cosine-of-pi-halves
    abs.
      times.
        cosine.
          pi.div 2
        1000
    1

  lt. ++> can-take-a-cosine-of-pi-thirds
    abs.
      minus.
        times.
          cosine.
            pi.div 3
          1000
        500
    1

  lt. ++> can-take-a-cosine-of-seventeen-radians
    abs.
      minus.
        17.cosine.times 1000
        -275
    1

  lt. ++> can-take-a-cosine-of-ten-billion
    abs.
      10000000000.cosine.minus 0.873119622676856
    1.0e-14

  lt. ++> can-take-a-cosine-of-zero
    abs.
      minus.
        0.cosine.times 1000
        1000
    1

  1.eq 0.cosine ++> can-take-an-exact-cosine-of-zero
