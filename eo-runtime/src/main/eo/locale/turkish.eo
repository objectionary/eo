# Turkish locale specializing the root `locale` with the dotted and
# dotless I mappings that Turkish and Azeri override the default with.
# Lower casing maps capital dotless I (U+0049) to small dotless i (U+0131)
# and capital dotted I (U+0130) to small dotted i (U+0069); upper casing
# maps small dotted i (U+0069) to capital dotted I (U+0130) and small
# dotless i (U+0131) to capital dotless I (U+0049). Each direction only
# touches two of the four characters, which is why `low-cased` and
# `up-cased` list different regexes. The Turkish replacements run before
# the root ASCII pass on purpose: once that pass folds capital dotless I
# into small dotted i the distinction is gone, so the order must not swap.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package locale
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[] > turkish
  locale.low-cased > [text] > low-cased
    string.replaced
      string.replaced
        text
        string.regex "/I/"
        "ı"
      string.regex "/İ/"
      "i"
  locale.up-cased > [text] > up-cased
    string.replaced
      string.replaced
        text
        string.regex "/i/"
        "İ"
      string.regex "/ı/"
      "I"

  eq. ++> can-lower-case-dotted-and-dotless-i
    "ıistanbul"
    turkish.low-cased "IİSTANBUL"

  eq. ++> can-lower-case-every-occurrence-of-a-mapped-character
    "ıııı"
    turkish.low-cased "IIII"

  eq. ++> can-round-trip-a-lower-cased-word
    "ıstanbul"
    turkish.low-cased
      turkish.up-cased "ıstanbul"

  eq. ++> can-round-trip-an-upper-cased-word
    "İSTANBUL"
    turkish.up-cased
      turkish.low-cased "İSTANBUL"

  eq. ++> can-upper-case-dotted-and-dotless-i
    "İSTANBUL"
    turkish.up-cased "istanbul"
