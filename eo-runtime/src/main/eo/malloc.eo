[] > malloc
  malloc.of > [scope] > empty
    0
    scope
  [object scope] > for
    malloc.of > @
      size.
        object >> bts!
      seq * > [^task m] >>
        m.write 0 bts
        task.scope m
  [] > of /Q.bytes
    ? > ^
    ? > size /Q.number
    ? > scope /{Q.chunk(Q.number)}

