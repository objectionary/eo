# Writes the `i64` as signed decimal digits.
#
# The digits are peeled off the magnitude, read as two unsigned
# thirty-two-bit halves, by dividing it by ten: each half stays below
# `2^32`, so the remainder of the high half times `2^32` plus the low half
# stays below `2^36`, a number a double keeps whole. The magnitude is the
# two's complement negated in the halves, the high one and a borrow into it
# when the low one is not zero, so no `i64.neg` is needed: it costs a full
# carry chain, and `i64.div` costs tens of megabytes (`i64/div.eo`), too
# much for an error message.
#
# `as-number` cannot be the way here: the nearest double of
# `9223372036854775807` is `2^63`, one past the `long` range, so the digits
# of `as-number.as-decimal` would name another number (#9725).

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package i64
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^num] > as-decimal
  if. > @
    spelled.eq --
    "0".as-bytes
    spelled
  if. > borrow
    low.eq 0
    0
    1
  [^num upper lower acc] >> digits
    if. > @
      and.
        upper.eq 0
        lower.eq 0
      acc
      num.digits
        number upperq
        number lowerq
        concat.
          as-char.
            plus.
              minus.
                number rem
                times.
                  number lowerq
                  10
              48
          acc
    floor. > lowerq!
      div.
        number rem
        10
    plus. > rem!
      times.
        upper.minus
          times.
            number upperq
            10
        4294967296
      lower
    floor. > upperq!
      upper.div 10
  as-number. > low
    as-u32.
      num.as-bytes.slice 4 4
  if. > spelled!
    high.as-number.lt 0 >> negative
    "-".as-bytes.concat
      digits >> written
        negative.if
          minus.
            0.minus
              as-number.
                as-i32. >> high
                  num.as-bytes.slice 0 4
            borrow
          high.as-number
        negative.if
          if.
            low.eq 0
            0
            4294967296.minus low
          low
        --
    written

  eq. ++> can-write-a-negative-past-i32-min
    "-2147483649"
    string -2147483649.as-i64.as-decimal

  eq. ++> can-write-a-negative-with-a-non-zero-low-half
    "-2147483649"
    string
      as-decimal.
        i64 FF-FF-FF-FF-7F-FF-FF-FF

  eq. ++> can-write-a-number-past-i32-max
    "2147483648"
    string 2147483648.as-i64.as-decimal

  eq. ++> can-write-the-maximum
    "9223372036854775807"
    string
      as-decimal.
        i64 7F-FF-FF-FF-FF-FF-FF-FF

  eq. ++> can-write-the-minimum
    "-9223372036854775808"
    string
      as-decimal.
        i64 80-00-00-00-00-00-00-00

  eq. ++> can-write-zero
    "0"
    string 0.as-i64.as-decimal
