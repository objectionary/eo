# Writes the `i64` as signed decimal digits, peeled off the magnitude split
# into two unsigned 32-bit halves divided by ten, so every intermediate stays
# below `2^36` (#9725).

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package i64
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^num] > as-decimal
  if. > @
    spelled.eq --
    "0".as-bytes
    if. >> spelled!
      high.as-number.lt 0 >> negative
      "-".as-bytes.concat
        digits >> written
          negative.if
            minus.
              0.minus
                as-number.
                  as-i32. >> high
                    num.as-bytes.slice 0 4
              floor.
                div.
                  plus.
                    as-number. (num.as-bytes.slice 4 4).as-u32 >> low
                    4294967295
                  4294967296
            high.as-number
          negative.if
            mod.
              4294967296.minus low
              4294967296
            low
          --
      written
  [^num upper lower acc] >> digits
    if. > @
      and.
        upper.eq 0
        lower.eq 0
      acc
      num.digits
        number
          floor. >> upperq!
            upper.div 10
        number
          floor. >> lowerq!
            div.
              number rem
              10
        concat.
          as-char.
            plus.
              minus.
                number
                  plus. >> rem!
                    times.
                      upper.minus ((number upperq).times 10)
                      4294967296
                    lower
                times.
                  number lowerq
                  10
              48
          acc

  eq. ++> can-write-a-negative-past-i32-min
    "-2147483649"
    string -2147483649.as-i64.as-decimal

  eq. ++> can-write-a-number-past-i32-max
    "2147483648"
    string 2147483648.as-i64.as-decimal

  eq. ++> can-write-the-maximum
    "9223372036854775807"
    string
      as-decimal.
        i64 7F-FF-FF-FF-FF-FF-FF-FF

  eq. ++> can-write-the-minimum
    "-9223372036854775808"
    string
      as-decimal.
        i64 80-00-00-00-00-00-00-00

  eq. ++> can-write-zero
    "0"
    string 0.as-i64.as-decimal
