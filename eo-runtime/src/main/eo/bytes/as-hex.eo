# Writes the bytes as uppercase hexadecimal pairs joined by a hyphen,
# so that the two bytes `0x4A 0x65` become `4A-65`.
#
# Each nibble is read as a number through the exponent pattern of `2^52`,
# a double with that exponent and a mantissa `m` being exactly `2^52 + m`,
# and then picks its digit out of a sixteen-character table.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package bytes
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^] > as-hex
  [^ index acc] >> rec-hex
    if. > @
      ^.^.size.gt index
      ^.rec-hex
        index.plus 1
        concat.
          if.
            acc.size.gt 0
            acc.concat 2D-
            acc
          pair
      acc
    ^.^.slice > byte
      index
      1
    concat. > pair
      slice. > [^ nibble] >> digit
        "0123456789ABCDEF".as-bytes
        minus.
          number
            43-30-00-00-00-00-00-00.or
              00-00-00-00-00-00-00.concat nibble
          4503599627370496
        1
      | (byte.right 4)
      digit
        byte.and 0F-
  | > @
    0
    --

  eq. ++> can-write-a-single-byte
    "41"
    string "A".as-bytes.as-hex

  eq. ++> can-join-bytes-with-hyphens
    "4A-65-66-66"
    string "Jeff".as-bytes.as-hex

  eq. ++> can-write-letter-nibbles
    "00-00-00-00-00-00-00-FF"
    string 255.as-i64.as-bytes.as-hex

  eq. ++> can-write-the-bytes-of-a-number
    "40-45-00-00-00-00-00-00"
    string 42.as-bytes.as-hex

  eq. ++> can-write-empty-bytes
    ""
    string --.as-hex

  eq. ++> can-write-a-64-byte-input-promptly
    "00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00"
    string
      00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00.as-hex
