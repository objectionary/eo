# Regular expression in Perl format.
# The pattern is the string it is taken off.
# It starts and ends with slash (e.g. "/(your-expression)/"),
# Also it can be specified by the flag option,
# e.g.
# ```
# (`Q.string.regex "/(word)/i").compiled.matches "WORD"
# ```
#
# There are two entry points and one letter between their names.
# `matches` answers whether the whole text matches: the block it finds has
# to start at zero and end at the length of the text, so a pattern that
# covers only part of it answers `false`.
# `match` searches instead: it hands back the first block found anywhere in
# the text, and `next` moves to the one after it.
# ```
# (`Q.string.regex "/[a-z]+/").compiled.matches "1abc"  # false
# (`Q.string.regex "/[a-z]+/").compiled.match "1abc"    # the block "abc"
# ```
#
# Supported flags:
# /d - Enables Unix lines mode.
# /i - Enables case-insensitive matching.
# /x - Permits whitespace and comments in pattern.
# /m - Enables multiline mode.
# /s - Enables dotall mode.
# /u - Enables Unicode-aware case folding.
#
# `parsed` is a recursive-descent parser that turns the pattern body into a
# tree of tagged tuples ("concat", "alt", "group", "repeat", "lit", "any",
# "class", "pred", "start", "end"); it never calls back into `regex`
# itself, so nothing here bootstraps off the engine it is building.
# `attempted` walks that tree and answers every way a node can match
# starting exactly at a given position, most-preferred first (more
# repetitions before fewer, an earlier alternative before a later one), so
# the first entry of a concatenation's answer is exactly what a
# backtracking search would try first. `matches` asks for a parse that
# lands exactly on the text length; `match` walks starting positions left
# to right and takes the first position with any answer at all, exactly
# like `Matcher.find`. Positions are counted in characters (`string.at`
# and `string.length` already treat a supplementary character as one),
# never in UTF-16 units.
#
# `serialized` is this engine's own format, not a `java.util.Pattern`
# blob: the flags, a NUL byte and the pattern body, so a `pattern` built
# straight from bytes re-parses its body the same way `compile` did.
# There is no encoder from an arbitrary code point back to UTF-8 bytes in
# the runtime (`number.as-char` only writes 0-127), so a captured group is
# always sliced out of the original text instead of rebuilt from parts.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^] > regex
  compile > @

  # Compiles the pattern text (`^.^`, e.g. "/[a-z]+/i") into a `pattern`,
  # or, on a missing slash or a syntax mistake, applies `cant-compile` to
  # a message describing what went wrong.
  [^ cant-compile] > compile
    if. > @
      opens.not
      cant-compile "regex is missing the opening slash"
      if.
        closes.eq 0
        cant-compile "regex is missing the closing slash"
        if.
          ok
          built
          cant-compile message
    ^.^ > expr!
    expr.starts-with "/" > opens!
    expr.last-index-of "/" > closes!
    if. > flags!
      expr.ends-with "/"
      ""
      expr.slice
        closes.plus 1
        expr.length.minus (closes.plus 1)
    expr.slice 1 (closes.minus 1) > body!
    ^.parsed body (flags.contains "x") > outcome!
    (outcome.at 0 ("" > [m])).eq "ok" > ok!
    outcome.at 1 ("" > [m]) > oreason!
    outcome.at 2 (-1 > [m]) > ooffset!
    if. > message
      ooffset.lt 0
      "regex syntax is invalid: %s".printf
        * oreason
      "regex syntax is invalid: %s at offset %d of the pattern".printf
        * oreason ooffset
    flags.chained (* (string 00-) body) > joined!
    ^.pattern joined.as-bytes > built!

  [^ serialized] > pattern
    ^.pattern serialized > compiled
    [^ txt] > match
      [^ position start from to groups existing] > matched
        groups.length > count
        start.gte 0 > exists
        ^.groups.at index > [^ index] > group
        ^.existing.at index > [^ index] > group-exists
        exists.if > next
          if.
            and.
              from.eq to
              to.eq ^.txt.length
            ^.missing
            ^.matched-from-index
              position.plus 1
              if.
                from.eq to
                to.plus 1
                to
          T
            "Matched block does not exist, can't get next"
        exists.if > text
          group 0
          T
            "Matched block does not exist, can't get text"
      [^ position start] > matched-from-index
        ^.^.decoded > src!
        src.at 0 ("" > [m]) > pflags!
        src.at 1 ("" > [m]) > pbody!
        ^.^.^.parsed pbody (pflags.contains "x") > outcome!
        outcome.at 1 ("" > [m]) > root!
        outcome.at 2 (0 > [m]) > total!
        ^.^.^.settings pflags > cfg!
        ^.^.^.searched root cfg ^.txt start total > found!
        (found.at 0 ("" > [m])).eq "ok" > hit!
        found.at 1 (-1 > [m]) > mfrom!
        found.at 2 (-1 > [m]) > mto!
        found.at 3 (* > [m]) > mgroups!
        ^.^.^.grouped ^.txt mfrom mto total mgroups > packed!
        hit.if > @
          ^.matched
            position
            start
            mfrom
            mto
            packed.at 0 (* > [m])
            packed.at 1 (* > [m])
          ^.missing
      [] > missing
        T > count
          "Matched block does not exist, can't get count"
        T > existing
          "Matched block does not exist, can't get groups"
        start.gte 0 > exists
        T > from
          "Matched block does not exist, can't get 'from' position"
        T > [index] > group
          "Matched block does not exist, can't get group"
        T > [index] > group-exists
          "Matched block does not exist, can't get group-exists"
        T > groups
          "Matched block does not exist, can't get groups"
        T > next
          "Matched block does not exist, can't get next"
        0 > position
        -1 > start
        T > text
          "Matched block does not exist, can't get text"
      matched-from-index 1 0 > next
    string ^.serialized > decoded-text!
    decoded-text.index-of (string 00-) > separator!
    * > decoded!
      decoded-text.slice 0 separator
      decoded-text.slice
        separator.plus 1
        decoded-text.length.minus (separator.plus 1)

  [^ txt] > matches
    ^.compile T > compiled!
    compiled.decoded > src!
    src.at 0 ("" > [m]) > pflags!
    src.at 1 ("" > [m]) > pbody!
    ^.parsed pbody (pflags.contains "x") > outcome!
    outcome.at 1 ("" > [m]) > root!
    outcome.at 2 (0 > [m]) > total!
    ^.settings pflags > cfg!
    ^.fully-matched root cfg txt total > @

  # Turns `flags` into the five booleans the matcher needs: case
  # insensitivity, Unicode-aware folding, dotall, multiline, unix lines.
  [^ flags] > settings
    * > @
      flags.contains "i"
      flags.contains "u"
      flags.contains "s"
      flags.contains "m"
      flags.contains "d"

  # ------------------------------------------------------------------
  # Parser: turns `body` (the text between the slashes) into a tree of
  # tagged tuples, threading a capturing-group counter through every
  # call so groups are numbered by the order their opening "(" appears.
  # A step succeeds as `* "ok" index node counter` or fails as
  # `* "error" description offset`.
  # ------------------------------------------------------------------
  [^ body extended] > parsed
    body.length > blen!
    ^.alt 0 0 > result!
    if. > @
      (result.at 0 ("" > [m])).eq "error"
      result
      if.
        (result.at 1 (0 > [m])).eq blen
        * "ok" (result.at 2 (* > [m])) (result.at 3 (0 > [m]))
        * "error" "Unmatched closing ')'" (result.at 1 (0 > [m]))

    [^ i] > skip
      ^.body.at i ("" > [m]) > c!
      if. > @
        ^.extended.not
        i
        if.
          c.eq " "
          ^.skip (i.plus 1)
          if.
            c.eq "\t"
            ^.skip (i.plus 1)
            if.
              c.eq "\n"
              ^.skip (i.plus 1)
              if.
                c.eq "\r"
                ^.skip (i.plus 1)
                if.
                  c.eq "#"
                  ^.skip (^.comment-end (i.plus 1))
                  i

    [^ i] > comment-end
      ^.body.at i ("" > [m]) > c!
      if. > @
        or.
          c.eq ""
          c.eq "\n"
        i
        ^.comment-end (i.plus 1)

    [^ i g] > alt
      ^.cat i g > first!
      if. > @
        (first.at 0 ("" > [m])).eq "error"
        first
        ^.alt-loop
          first.at 1 (0 > [m])
          first.at 3 (0 > [m])
          * (first.at 2 (* > [m]))

    [^ i g branches] > alt-loop
      ^.skip i > j!
      if. > @
        (^.body.at j ("" > [m])).eq "|"
        ^.alt-continue (j.plus 1) g branches
        * "ok" j (^.wrap-branches branches) g

    [^ j g branches] > alt-continue
      ^.cat j g > nxt!
      if. > @
        (nxt.at 0 ("" > [m])).eq "error"
        nxt
        ^.alt-loop
          nxt.at 1 (0 > [m])
          nxt.at 3 (0 > [m])
          branches.with (nxt.at 2 (* > [m]))

    [^ branches] > wrap-branches
      if. > @
        branches.length.eq 1
        branches.at 0 (* > [m])
        * "alt" branches

    [^ i g] > cat
      ^.cat-loop i g *

    [^ i g items] > cat-loop
      ^.skip i > j!
      ^.body.at j ("" > [m]) > c!
      if. > @
        or.
          c.eq ""
          or.
            c.eq "|"
            c.eq ")"
        * "ok" j (^.wrap-items items) g
        ^.cat-continue j g items

    [^ j g items] > cat-continue
      ^.piece j g > pc!
      if. > @
        (pc.at 0 ("" > [m])).eq "error"
        pc
        ^.cat-loop
          pc.at 1 (0 > [m])
          pc.at 3 (0 > [m])
          items.with (pc.at 2 (* > [m]))

    [^ items] > wrap-items
      if. > @
        items.length.eq 1
        items.at 0 (* > [m])
        * "concat" items

    [^ i g] > piece
      ^.unit i g > u!
      if. > @
        (u.at 0 ("" > [m])).eq "error"
        u
        ^.apply-quant
          u.at 1 (0 > [m])
          u.at 2 (* > [m])
          u.at 3 (0 > [m])

    [^ i node g] > apply-quant
      ^.skip i > j!
      ^.quant j > q!
      q.at 0 (1 > [m]) > mn!
      q.at 1 (1 > [m]) > mx!
      q.at 2 (j > [m]) > after!
      if. > @
        and.
          mn.eq 1
          mx.eq 1
        * "ok" after node g
        * "ok" after (* "repeat" node mn mx) g

    [^ j] > quant
      ^.body.at j ("" > [m]) > c!
      if. > @
        c.eq "*"
        * 0 -1 (j.plus 1)
        if.
          c.eq "+"
          * 1 -1 (j.plus 1)
          if.
            c.eq "?"
            * 0 1 (j.plus 1)
            if.
              c.eq "{"
              ^.try-braces (j.plus 1) j
              * 1 1 j

    [^ k fallback] > try-braces
      ^.digits-run k > d1!
      if. > @
        (d1.at 2 (false > [m])).not
        * 1 1 fallback
        ^.after-first-digits
          d1.at 0 (0 > [m])
          d1.at 1 (0 > [m])
          fallback

    [^ n1 k fallback] > after-first-digits
      ^.body.at k ("" > [m]) > c!
      if. > @
        c.eq "}"
        * n1 n1 (k.plus 1)
        if.
          c.eq ","
          ^.after-comma n1 (k.plus 1) fallback
          * 1 1 fallback

    [^ n1 k fallback] > after-comma
      ^.digits-run k > d2!
      d2.at 2 (false > [m]) > has2!
      d2.at 0 (0 > [m]) > n2!
      d2.at 1 (k > [m]) > k2!
      ^.body.at k2 ("" > [m]) > c!
      if. > @
        c.eq "}"
        if.
          has2
          * n1 n2 (k2.plus 1)
          * n1 -1 (k2.plus 1)
        * 1 1 fallback

    [^ k] > digits-run
      ^.digits-run-k k 0 false

    [^ k acc has] > digits-run-k
      ^.body.at k ("" > [m]) > c!
      c.as-ascii (-1 > [m]) > code!
      if. > @
        and.
          code.gte 48
          code.lte 57
        ^.digits-run-k
          k.plus 1
          (acc.times 10).plus (code.minus 48)
          true
        * acc k has

    [^ c] > dangling-msg
      "Dangling meta character '%s'".printf (* c)

    [^ i g] > unit
      ^.skip i > j!
      ^.body.at j ("" > [m]) > c!
      if. > @
        or.
          c.eq "*"
          or.
            c.eq "+"
            c.eq "?"
        * "error" (^.dangling-msg c) j
        if.
          c.eq "."
          * "ok" (j.plus 1) (* "any") g
          if.
            c.eq "^"
            * "ok" (j.plus 1) (* "start") g
            if.
              c.eq "$"
              * "ok" (j.plus 1) (* "end") g
              if.
                c.eq "("
                ^.grp (j.plus 1) g
                if.
                  c.eq "["
                  ^.cls-node (j.plus 1) g
                  if.
                    c.eq "\\"
                    ^.esc-node j g
                    * "ok" (j.plus 1) (* "lit" c) g

    [^ j g] > esc-node
      ^.body.at (j.plus 1) ("" > [m]) > e!
      if. > @
        e.eq ""
        * "error" "Trailing backslash" j
        if.
          e.eq "d"
          * "ok" (j.plus 2) (* "pred" "digit") g
          if.
            e.eq "D"
            * "ok" (j.plus 2) (* "pred" "ndigit") g
            if.
              e.eq "s"
              * "ok" (j.plus 2) (* "pred" "space") g
              if.
                e.eq "S"
                * "ok" (j.plus 2) (* "pred" "nspace") g
                if.
                  e.eq "w"
                  * "ok" (j.plus 2) (* "pred" "word") g
                  if.
                    e.eq "W"
                    * "ok" (j.plus 2) (* "pred" "nword") g
                    if.
                      e.eq "x"
                      ^.hex-node j g
                      if.
                        e.eq "n"
                        * "ok" (j.plus 2) (* "lit" "\n") g
                        if.
                          e.eq "t"
                          * "ok" (j.plus 2) (* "lit" "\t") g
                          if.
                            e.eq "r"
                            * "ok" (j.plus 2) (* "lit" "\r") g
                            * "ok" (j.plus 2) (* "lit" e) g

    [^ j g] > hex-node
      ^.body.at (j.plus 2) ("" > [m]) > h1!
      ^.body.at (j.plus 3) ("" > [m]) > h2!
      h1.as-ascii (-1 > [m]) > c1!
      h2.as-ascii (-1 > [m]) > c2!
      ^.hex-digit c1 > v1!
      ^.hex-digit c2 > v2!
      if. > @
        or.
          v1.lt 0
          v2.lt 0
        * "error" "Illegal hexadecimal escape sequence" j
        * "ok" (j.plus 4) (* "lit" (string ((v1.times 16).plus v2).as-char)) g

    [^ code] > hex-digit
      if. > @
        and.
          code.gte 48
          code.lte 57
        code.minus 48
        if.
          and.
            code.gte 65
            code.lte 70
          (code.minus 65).plus 10
          if.
            and.
              code.gte 97
              code.lte 102
            (code.minus 97).plus 10
            -1

    [^ j g] > grp
      ^.body.at j ("" > [m]) > c1!
      ^.body.at (j.plus 1) ("" > [m]) > c2!
      if. > @
        and.
          c1.eq "?"
          c2.eq ":"
        ^.grp-body (j.plus 2) g -1
        if.
          c1.eq "?"
          * "error" "Unknown inline modifier" j
          ^.grp-body j (g.plus 1) (g.plus 1)

    [^ j g gnum] > grp-body
      ^.alt j g > inner!
      if. > @
        (inner.at 0 ("" > [m])).eq "error"
        inner
        ^.grp-close inner gnum

    [^ inner gnum] > grp-close
      inner.at 1 (0 > [m]) > idx!
      ^.body.at idx ("" > [m]) > c!
      if. > @
        c.eq ")"
        * "ok" (idx.plus 1) (* "group" (inner.at 2 (* > [m])) gnum) (inner.at 3 (0 > [m]))
        * "error" "Unclosed group" idx

    [^ j g] > cls-node
      ^.body.at j ("" > [m]) > c1!
      c1.eq "^" > neg!
      if. > @
        neg
        ^.cls-finish (^.cls-items (j.plus 1) *) neg g
        ^.cls-finish (^.cls-items j *) neg g

    [^ res neg g] > cls-finish
      if. > @
        (res.at 0 ("" > [m])).eq "error"
        res
        * "ok" (res.at 1 (0 > [m])) (* "class" (res.at 2 (* > [m])) neg) g

    [^ k items] > cls-items
      ^.body.at k ("" > [m]) > c!
      if. > @
        c.eq ""
        * "error" "Unclosed character class" k
        if.
          c.eq "]"
          * "ok" (k.plus 1) items -1
          ^.cls-continue k items

    [^ k items] > cls-continue
      ^.cls-atom k > a!
      if. > @
        (a.at 0 ("" > [m])).eq "error"
        a
        ^.cls-after-atom
          a.at 1 ("" > [m])
          a.at 2 ("" > [m])
          a.at 3 (0 > [m])
          items

    [^ kind val idx items] > cls-after-atom
      if. > @
        kind.eq "char"
        ^.cls-maybe-range val idx items
        ^.cls-items idx (items.with (* "pred" val))

    [^ ch idx items] > cls-maybe-range
      ^.body.at idx ("" > [m]) > d!
      ^.body.at (idx.plus 1) ("" > [m]) > after!
      if. > @
        and.
          d.eq "-"
          and.
            (after.eq "").not
            (after.eq "]").not
        ^.cls-range ch idx items
        ^.cls-items idx (items.with (* "char" ch))

    [^ ch idx items] > cls-range
      ^.cls-atom (idx.plus 1) > b!
      if. > @
        (b.at 0 ("" > [m])).eq "error"
        b
        if.
          (b.at 1 ("" > [m])).eq "char"
          ^.cls-items
            b.at 3 (0 > [m])
            items.with (* "range" ch (b.at 2 ("" > [m])))
          * "error" "Illegal character range" idx

    [^ k] > cls-atom
      ^.body.at k ("" > [m]) > c!
      if. > @
        c.eq ""
        * "error" "Unclosed character class" k
        if.
          c.eq "\\"
          ^.cls-esc k
          * "ok" "char" c (k.plus 1)

    [^ k] > cls-esc
      ^.body.at (k.plus 1) ("" > [m]) > e!
      if. > @
        e.eq ""
        * "error" "Trailing backslash" k
        if.
          e.eq "d"
          * "ok" "pred" "digit" (k.plus 2)
          if.
            e.eq "D"
            * "ok" "pred" "ndigit" (k.plus 2)
            if.
              e.eq "s"
              * "ok" "pred" "space" (k.plus 2)
              if.
                e.eq "S"
                * "ok" "pred" "nspace" (k.plus 2)
                if.
                  e.eq "w"
                  * "ok" "pred" "word" (k.plus 2)
                  if.
                    e.eq "W"
                    * "ok" "pred" "nword" (k.plus 2)
                    if.
                      e.eq "x"
                      ^.cls-hex k
                      if.
                        e.eq "n"
                        * "ok" "char" "\n" (k.plus 2)
                        if.
                          e.eq "t"
                          * "ok" "char" "\t" (k.plus 2)
                          if.
                            e.eq "r"
                            * "ok" "char" "\r" (k.plus 2)
                            * "ok" "char" e (k.plus 2)

    [^ k] > cls-hex
      ^.body.at (k.plus 2) ("" > [m]) > h1!
      ^.body.at (k.plus 3) ("" > [m]) > h2!
      h1.as-ascii (-1 > [m]) > c1!
      h2.as-ascii (-1 > [m]) > c2!
      ^.hex-digit c1 > v1!
      ^.hex-digit c2 > v2!
      if. > @
        or.
          v1.lt 0
          v2.lt 0
        * "error" "Illegal hexadecimal escape sequence" k
        * "ok" "char" (string ((v1.times 16).plus v2).as-char) (k.plus 4)

  # ------------------------------------------------------------------
  # Matcher: `attempted` answers every way `node` can match starting
  # exactly at `pos`, as a tuple of `* end groups` candidates, ordered
  # most-preferred first. `ctx` bundles the fixed context of one search:
  # `* text length case-insensitive unicode-case dotall multiline
  # unix-lines`.
  # ------------------------------------------------------------------
  [^ ctx node pos groups] > attempted
    node.at 0 ("" > [m]) > tag!
    ctx.at 0 ("" > [m]) > text!
    ctx.at 1 (0 > [m]) > tlen!
    ctx.at 2 (false > [m]) > ci!
    ctx.at 3 (false > [m]) > uc!
    ctx.at 4 (false > [m]) > da!
    ctx.at 5 (false > [m]) > ml!
    ctx.at 6 (false > [m]) > ul!
    text.at pos ("" > [m]) > cur!
    if. > @
      tag.eq "concat"
      ^.seq ctx (node.at 1 (* > [m])) 0 pos groups
      if.
        tag.eq "alt"
        ^.choice ctx (node.at 1 (* > [m])) 0 pos groups
        if.
          tag.eq "group"
          ^.grouped-attempt ctx node pos groups
          if.
            tag.eq "repeat"
            ^.rep
              ctx
              node.at 1 (* > [m])
              pos
              groups
              node.at 2 (0 > [m])
              node.at 3 (-1 > [m])
            if.
              tag.eq "lit"
              ^.one-char ci uc cur (node.at 1 ("" > [m])) pos groups
              if.
                tag.eq "any"
                ^.one-any da ul cur pos groups
                if.
                  tag.eq "class"
                  ^.one-class
                    ci
                    uc
                    cur
                    node.at 1 (* > [m])
                    node.at 2 (false > [m])
                    pos
                    groups
                  if.
                    tag.eq "pred"
                    ^.one-pred cur (node.at 1 ("" > [m])) pos groups
                    if.
                      tag.eq "start"
                      ^.at-start text pos ml ul groups
                      ^.at-end text pos tlen ml ul groups

  [^ ctx children idx pos groups] > seq
    if. > @
      idx.gte children.length
      * (* pos groups)
      ^.flat-map-seq
        ctx
        children
        idx.plus 1
        ^.attempted ctx (children.at idx (* > [m])) pos groups

  [^ ctx children idx cands] > flat-map-seq
    ^.flat-map-seq-k ctx children idx cands 0

  [^ ctx children idx cands k] > flat-map-seq-k
    if. > @
      k.gte cands.length
      *
      concat.
        ^.seq
          ctx
          children
          idx
          ^.cand-end (cands.at k (* > [m]))
          ^.cand-groups (cands.at k (* > [m]))
        ^.flat-map-seq-k ctx children idx cands (k.plus 1)

  [^ ctx branches idx pos groups] > choice
    if. > @
      idx.gte branches.length
      *
      concat.
        ^.attempted ctx (branches.at idx (* > [m])) pos groups
        ^.choice ctx branches (idx.plus 1) pos groups

  [^ ctx node pos groups] > grouped-attempt
    node.at 1 (* > [m]) > child!
    node.at 2 (-1 > [m]) > gnum!
    ^.attempted ctx child pos groups > inner!
    if. > @
      gnum.lt 0
      inner
      ^.map-stamp inner pos gnum 0

  [^ cands start gnum k] > map-stamp
    if. > @
      k.gte cands.length
      *
      with.
        ^.map-stamp cands start gnum (k.plus 1)
        ^.one-stamp (cands.at k (* > [m])) start gnum

  [^ cand start gnum] > one-stamp
    cand.at 0 (-1 > [m]) > end!
    cand.at 1 (* > [m]) > gs!
    * end (^.replaced-at gs (gnum.minus 1) (* start end true))

  [^ tup idx val] > replaced-at
    concat. > @
      with.
        tup.front idx
        val
      tup.back
        tup.length.minus (idx.plus 1)

  [^ c] > cand-end
    c.at 0 (-1 > [m])

  [^ c] > cand-groups
    c.at 1 (* > [m])

  [^ ctx child pos groups mn mx] > rep
    if. > @
      mn.gt 0
      ^.rep-forced ctx child pos groups mn mx
      if.
        mx.eq 0
        * (* pos groups)
        ^.rep-optional ctx child pos groups mx

  [^ ctx child pos groups mn mx] > rep-forced
    ^.rep-forced-k ctx child pos groups mn mx (^.attempted ctx child pos groups) 0

  [^ ctx child pos groups mn mx own k] > rep-forced-k
    if. > @
      k.gte own.length
      *
      concat.
        ^.rep-forced-one ctx child pos mn mx (own.at k (* > [m]))
        ^.rep-forced-k ctx child pos groups mn mx own (k.plus 1)

  [^ ctx child pos mn mx cand] > rep-forced-one
    cand.at 0 (-1 > [m]) > e!
    cand.at 1 (* > [m]) > g!
    if. > @
      e.eq pos
      * (* e g)
      ^.rep ctx child e g (mn.minus 1) (^.dec-or-neg mx)

  [^ ctx child pos groups mx] > rep-optional
    ^.rep-optional-k ctx child pos groups mx (^.attempted ctx child pos groups) 0

  [^ ctx child pos groups mx own k] > rep-optional-k
    if. > @
      k.gte own.length
      * (* pos groups)
      concat.
        ^.rep-optional-one ctx child pos mx (own.at k (* > [m]))
        ^.rep-optional-k ctx child pos groups mx own (k.plus 1)

  [^ ctx child pos mx cand] > rep-optional-one
    cand.at 0 (-1 > [m]) > e!
    cand.at 1 (* > [m]) > g!
    if. > @
      e.eq pos
      * (* e g)
      ^.rep ctx child e g 0 (^.dec-or-neg mx)

