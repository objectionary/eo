      cur.eq ""
      *
      if.
        ^.same ci uc cur expected
        * (* (pos.plus 1) groups)
        *

  [^ da ul cur pos groups] > one-any
    if. > @
      or.
        cur.eq ""
        and.
          da.not
          ^.is-terminator ul cur
