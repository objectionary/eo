  [^ ctx root p tlen groups0] > scan-from
    ^.attempted ctx root p groups0 > cands!
    if. > @
      p.gt tlen
      * "no"
      if.
        cands.length.gt 0
        ^.found p (cands.at 0 (* > [m]))
        ^.scan-from ctx root (p.plus 1) tlen groups0

  [^ p cand] > found
    * "ok" p (^.cand-end cand) (^.cand-groups cand)

  [^ n] > empty-groups
