      n.lte 0
      *
      (^.empty-groups (n.minus 1)).with (* -1 -1 false)

  # Whether `root` can match all of `text`, backtracking through every
  # possibility instead of only the greediest one, exactly like
  # `Matcher.matches`.
  [^ root cfg text total] > fully-matched
    cfg.at 0 (false > [m]) > ci!
    cfg.at 1 (false > [m]) > uc!
    cfg.at 2 (false > [m]) > da!
    cfg.at 3 (false > [m]) > ml!
    cfg.at 4 (false > [m]) > ul!
    * text (text.length) ci uc da ml ul > ctx!
    ^.attempted ctx root 0 (^.empty-groups total) > cands!
    ^.any-full cands (text.length) 0 > @

  [^ cands tlen k] > any-full
    if. > @
      k.gte cands.length
      false
      if.
        (^.cand-end (cands.at k (* > [m]))).eq tlen
