    ch.as-ascii (-1 > [m]) > c!
    and. > digit!
      c.gte 48
      c.lte 57
    or. > space!
      c.eq 32
      or.
        c.eq 9
        or.
          c.eq 10
          or.
            c.eq 13
            or.
              c.eq 11
              c.eq 12
    or. > word!
      or.
        and.
          c.gte 48
          c.lte 57
        or.
          and.
            c.gte 65
            c.lte 90
          and.
            c.gte 97
            c.lte 122
      c.eq 95
    if. > @
      tag.eq "digit"
      digit
      if.
        tag.eq "ndigit"
        digit.not
        if.
          tag.eq "space"
          space
          if.
            tag.eq "nspace"
            space.not
            if.
              tag.eq "word"
              word
              word.not

  [^ text pos ml ul groups] > at-start
    if. > @
      or.
        pos.eq 0
        and.
          ml
          ^.is-terminator ul (text.at (pos.minus 1) ("" > [m]))
      * (* pos groups)
      *

  [^ text pos tlen ml ul groups] > at-end
    if. > @
      or.
        pos.eq tlen
        or.
          and.
            ml
            ^.is-terminator ul (text.at pos ("" > [m]))
          and.
            ml.not
            ^.end-before-final-terminator text pos tlen ul
      * (* pos groups)
      *

