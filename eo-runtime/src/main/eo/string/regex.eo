+spdx SPDX-License-Identifier: MIT

[^] > regex
  compile > @
  [^ cant-compile] > compile
    if. > @
      ^.^.starts-with "/"
      if.
        closes.eq 0
        cant-compile
          "regex is missing the closing slash"
        if.
          flags-valid 0
          built.checked reported
          cant-compile
            "regex flags '%s' must be a sequence of 'd', 'i', 'm', 's', 'u' and 'x'".printf
              * flags
      cant-compile
        "regex is missing the opening slash"
    ^.^.slice > body
      1
      closes.minus 1
    ^.pattern > built
      body
      flags
    ^.^.last-index-of "/" > closes
    ^.^.slice > flags
      closes.plus 1
      ^.^.length.minus
        closes.plus 1
    if. > [^ index] > flags-valid
      index.eq ^.flags.length
      true
      and.
        "dimsux".contains
          ^.flags.at index
        ^.flags-valid
          index.plus 1
    [^ reason index] > reported
      ^.cant-compile > @
        if.
          offset.lt 0
          "regex syntax is invalid: %s".printf
            * reason
          "regex syntax is invalid: %s at offset %d of the pattern".printf
            * reason offset
      index.minus > offset
        ^.built.source.length.minus ^.body.length
  [^ body flags] > pattern
    [] > checked /Q.string.regex.pattern
      ? > ^
      ? > cant-check /{Q.string Q.number}
    ^.pattern > compiled
      body
      flags
    [^ txt] > match
      [^ position start from to groups existing] > matched
        groups.length > count
        start.gte 0 > exists
        ^.groups.at index > [^ index] > group
        ^.existing.at index > [^ index] > group-exists
        exists.if > next
          if.
            and.
              from.eq to
              to.eq ^.txt.length
            ^.missing
              position.plus 1
            ^.matched-from-index
              position.plus 1
              if.
                from.eq to
                to.plus 1
                to
          T
            "Matched block does not exist, can't get next"
        exists.if > text
          group 0
          T
            "Matched block does not exist, can't get text"
      [^ position start] > matched-from-index
        if. > @
          block.length.eq 0
          ^.missing position
          ^.matched
            position
            start
            block.at 0
            block.at 1
            block.at 2
            block.at 3
        ^.searched start > block
      [^ position] > missing
        T > count
          "Matched block does not exist, can't get count"
        T > existing
          "Matched block does not exist, can't get groups"
        start.gte 0 > exists
        T > from
          "Matched block does not exist, can't get 'from' position"
        T > [index] > group
          "Matched block does not exist, can't get group"
        T > [index] > group-exists
          "Matched block does not exist, can't get group-exists"
        T > groups
          "Matched block does not exist, can't get groups"
        T > next
          "Matched block does not exist, can't get next"
        -1 > start
        T > text
          "Matched block does not exist, can't get text"
        T > to
          "Matched block does not exist, can't get 'to' position"
      matched-from-index 1 0 > next
      [] > searched /Q.tuple
        ? > ^
        ? > start /Q.number
    [^ txt] > matches
      found.exists.and > @
        and.
          found.to.eq txt.length
          found.from.eq 0
      ^.^.pattern > anchored
        "(?:%s)(?![\\s\\S])".printf
          * ^.body
        ^.flags
      ^.^.pattern > commented
        "(?:%s\n)(?![\\s\\S])".printf
          * ^.body
        ^.flags
      next. > found
        match.
          anchored.checked retry-commented
          txt
      ^.^.pattern > quoted
        "(?:%s\\E)(?![\\s\\S])".printf
          * ^.body
        ^.flags
      ^.commented.checked ^.retry-quoted > [^ reason index] > retry-commented
      ^.quoted.checked > [^ reason index] > retry-quoted
    if. > source
      flags.eq ""
      body
      "(?%s)%s".printf
        * flags body

