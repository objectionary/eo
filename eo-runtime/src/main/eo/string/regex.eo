      and.
        1.eq n.from
        6.eq n.to
    next. > n
      "/[a-z]+/".regex.match "!hello!"

  eq. ++> can-return-the-matched-string-sequence
    text.
      next.
        "/[a-z]+/".regex.match "!hello!"
    "hello"

  ++> can-return-the-second-matched-block
    and. > @
      and.
        and.
          and.
            second.text.eq "world"
            second.position.eq 2
          second.start.eq 6
