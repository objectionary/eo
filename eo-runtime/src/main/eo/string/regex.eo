            second.position.eq 2
          second.start.eq 6
        second.from.eq 7
      second.to.eq 12
    next. > second
      next.
        "/[a-z]+/".regex.match "!hello!world!"

  "/(?i:a)b/".regex.compiled.matches "Ab" ++> can-scope-an-inline-flag-group

  eq. ++> can-search-from-a-position
    3
    at.
      searched.
        "/a/".regex.match "xaxa"
        2
      0

  eq. ++> can-search-from-the-text-length
    3
    at.
      searched.
        "/$/".regex.match "abc"
        3
      1

  not. ++> can-stop-at-a-terminal-zero-width-match
    exists. ("/$/".regex.match "x").next.next

