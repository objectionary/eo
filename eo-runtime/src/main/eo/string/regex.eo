    "/a*+a/".regex.compiled.matches "aaa"

  not. ++> can-tell-a-quoted-block-is-not-a-pattern
    "/x\\Q.*\\Ey/".regex.compiled.matches "xaay"

  not. ++> can-tell-an-inline-flag-ends-with-its-group
    "/(a(?i)b)c/".regex.compiled.matches "aBC"

  not. ++> can-tell-an-inline-flag-group-ends-at-its-parenthesis
    "/(?i:a)b/".regex.compiled.matches "AB"

  not. ++> can-tell-ascii-folding-leaves-cyrillic-letters-alone
    "/ж/i".regex.compiled.matches "Ж"

  not. ++> can-tell-ascii-folding-leaves-latin-letters-alone
    "/é/i".regex.compiled.matches "É"

  not. ++> can-tell-ascii-folding-leaves-the-dotted-capital-i-alone
    "/[a-z]/i".regex.compiled.matches "İ"

  not. ++> can-tell-it-does-not-match-a-text-against-a-wrong-pattern
    "/[a-z]+/".regex.compiled.matches "123"

  not. ++> can-tell-it-does-not-match-an-anchored-pattern-with-a-trailing-newline
    "/^[0-9]+$/".regex.compiled.matches "123\n"

  not. ++> can-tell-it-does-not-match-with-unmatched-leading-characters
    "/[a-z]+/".regex.compiled.matches "1abc"

  not. ++> can-tell-the-end-anchor-needs-the-end-of-the-text
    exists.
      next.
        "/a$/".regex.match "a\nb"

  not. ++> can-tell-the-input-begin-anchor-needs-the-start-of-the-text
    exists.
      next.
        "/\\Ab/m".regex.match "a\nb"

  not. ++> can-tell-the-input-end-anchor-needs-the-end-of-the-text
    exists.
      next.
        "/a\\z/".regex.match "a\n"

  not. ++> can-tell-the-unix-lines-flag-ignores-a-carriage-return
    exists.
      next.
