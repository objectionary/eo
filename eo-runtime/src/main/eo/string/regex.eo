  # characters) where `root` matches, exactly like `Matcher.find`.
  [^ root cfg text start total] > searched
    cfg.at 0 (false > [m]) > ci!
    cfg.at 1 (false > [m]) > uc!
    cfg.at 2 (false > [m]) > da!
    cfg.at 3 (false > [m]) > ml!
    cfg.at 4 (false > [m]) > ul!
