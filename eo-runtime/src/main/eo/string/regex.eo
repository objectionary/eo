  # Slices the matched text and the `total` capturing groups out of
  # `txt`, as `* groups existing`, where index 0 of each is the whole
  # match; a group that never participated slices to "" and `false`.
  [^ txt mfrom mto total mgroups] > grouped
    ^.grouped-k
      txt
      total
      mgroups
      1
      * (txt.slice mfrom (mto.minus mfrom))
      * true

  [^ txt total mgroups k gtexts gflags] > grouped-k
    if. > @
      k.gt total
      * gtexts gflags
      ^.grouped-k
        txt
        total
        mgroups
        k.plus 1
        gtexts.with (^.group-text txt (mgroups.at (k.minus 1) (* -1 -1 false > [m])))
        gflags.with (^.group-participated (mgroups.at (k.minus 1) (* -1 -1 false > [m])))

  [^ entry] > group-participated
    entry.at 2 (false > [m])

  [^ txt entry] > group-text
    if. > @
      ^.group-participated entry
      txt.slice
        entry.at 0 (-1 > [m])
        (entry.at 1 (-1 > [m])).minus (entry.at 0 (-1 > [m]))
      ""

  eq. ++> can-advance-after-a-zero-width-match
    1
    from. ("/a*/".regex.match "xa").next.next

  ++> can-count-supplementary-characters-as-one-position
    and. > @
      and.
        0.eq first.from
        1.eq first.to
      and.
        1.eq second.from
        2.eq second.to
    next. > first
      "/./".regex.compiled.match "😀x"
    first.next > second

