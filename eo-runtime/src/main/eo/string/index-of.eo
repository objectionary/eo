# Returns index of `substring` in the string.
# If no `substring` was found, it returns -1.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^text substring] > index-of
  if. > @
    and.
      part.size.lte tlen
      gte.
        number >> found
          rec-index-of >>!
            number
              minus. >>!
                number txt.size! >> tlen
                size.
                  substring >> part!
            0
        0
    length.
      string
        slice.
          text >> txt!
          0
          found
    -1
  [^text end idx] >> rec-index-of
    if. > @
      end.eq idx
      if.
        eq. >> includes
          txt.slice idx part.size
          part
        idx
        -1
      includes.if
        idx
        text.rec-index-of
          end
          as-number.
            idx.plus 1

  eq. ++> can-find-a-present-substring-in-utf-text
    3
    "привет, друг!".index-of "в"

  eq. ++> can-find-no-index-of-a-longer-substring
    -1
    "Hello".index-of "Somebody"

  eq. ++> can-find-no-index-of-an-absent-substring-in-a-long-text
    -1
    index-of.
      "x".repeated 500
      "y"

  eq. ++> can-find-no-index-of-an-absent-substring-in-utf-text
    -1
    "привет, друг!".index-of "x"

  eq. ++> can-find-no-index-of-an-absent-substring-of-the-same-length
    -1
    "Hello".index-of "world"

  eq. ++> can-return-the-index-of-a-substring
    6
    "Hello \n world".index-of "\n"

  eq. ++> can-return-the-index-of-a-substring-at-the-end
    6
    "Hello world".index-of "world"
