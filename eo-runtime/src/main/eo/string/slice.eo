# Takes a piece of the string as another string, counting characters and not
# bytes. Here `start` must be a non-negative integer index to start slicing
# from, while `len` must be a non-negative integer amount of characters to
# take. A fractional, `nan` or infinite `start` or `len` terminates the
# computation immediately. Both of them walk the UTF-8 sequence character by
# character, so a multi-byte character counts as one. An index outside the
# bounds of the string terminates the computation. Every multi-byte sequence is
# validated against the UTF-8 rules of the Unicode standard (Table 3-7), the
# same way `length` does: each following byte must be a `10xxxxxx` continuation
# byte, and the second byte is range-checked so that overlong encodings
# (`C0`/`C1` leads, `E0` with an `80`-`9F` second byte, `F0` with an `80`-`8F`
# second byte), UTF-16 surrogates (`ED` with an `A0`-`BF` second byte) and code
# points above U+10FFFF (`F4` with a `90`-`BF` second byte, and `F5`-`FF` leads)
# are rejected. A malformed sequence terminates the computation, exactly like a
# truncated character does.
#
# @todo #9650:30min Remove `+unlint too-deep-object:118-152` from the
#  metas below. It hides how deep `recidx` nests the checks of a three-byte
#  and a four-byte character, up to 16 levels where the lint allows 12. Move
#  those checks into objects of their own, so that `recidx` nests no deeper.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+unlint too-deep-object:118-152
+version 0.0.0

[^text start len] > slice
  if. > @
    or.
      lt.
        number start! >> nstart
        0
      nstart.is-integer.not
    T
      nstart.is-finite.if
        "Start index must be a non-negative integer, but was %f".printf
          * nstart
        "Start index must be a non-negative integer, but was %s".printf
          *
            string nstart.as-scientific
    if.
      or.
        lt.
          number len! >> nlen
          0
        nlen.is-integer.not
      T
        nlen.is-finite.if
          "Length to slice must be a non-negative integer, but was %f".printf
            * nlen
          "Length to slice must be a non-negative integer, but was %s".printf
            *
              string nlen.as-scientific
      seq *
        number >> bstart
          recidx >>!
            0
            0
            nstart
            "Start index (%s) is out of string bounds".printf
              *
                if. > [num] >> printed
                  9.223372036854776e18.gt num
                  "%d".printf
                    * num
                  string num.as-scientific
                | nstart
        minus. >> blen
          [^ctx index accum result cause] >> recidx
            if. > @
              accum.eq result
              index
              if.
                index.eq size
                T cause
                if.
                  eq.
                    and.
                      ctx.text.as-bytes.slice index 1 >> byte
                      80-
                    00-
                  ctx.recidx
                    increase index 1 true
                    accum.plus 1
                    result
                    cause
                  if.
                    eq. (byte.and E0-) C0-
                    ctx.recidx
                      increase
                        index
                        2
                        ((byte.and FE-).eq C0-).not.and
                          eq. (b1.and C0-) 80- >> b1cont
                      accum.plus 1
                      result
                      cause
                    if.
                      eq. (byte.and F0-) E0-
                      ctx.recidx
                        increase
                          index
                          3
                          and.
                            eq. >> b2cont
                              and.
                                ctx.text.as-bytes.slice (index.plus 2) 1
                                C0-
                              80-
                            if.
                              byte.eq E0-
                              eq.
                                and.
                                  ctx.text.as-bytes.slice (index.plus 1) 1 >> b1
                                  E0-
                                A0-
                              if.
                                byte.eq ED-
                                eq. (b1.and E0-) 80-
                                b1cont
                        accum.plus 1
                        result
                        cause
                      if.
                        eq. (byte.and F8-) F0-
                        ctx.recidx
                          increase
                            index
                            4
                            b2cont.and
                              and.
                                eq.
                                  and.
                                    ctx.text.as-bytes.slice (index.plus 3) 1
                                    C0-
                                  80-
                                if.
                                  byte.eq F0-
                                  ((b1.and F0-).eq 90-).or
                                    eq. (b1.and E0-) A0-
                                  if.
                                    byte.eq F4-
                                    eq. (b1.and F0-) 80-
                                    if.
                                      or. >>
                                        byte.eq F1- >> leadf1
                                        or. (byte.eq F2-) (byte.eq F3-)
                                      b1cont
                                      false
                          accum.plus 1
                          result
                          cause
                        T
                          "Unknown byte format (%x), can't recognize character".printf
                            * byte
          |
            bstart
            0
            nlen
            "Start index + length to slice (%s) is out of string bounds".printf
              *
                printed
                  nstart.plus nlen
          bstart
        if.
          nlen.eq 0
          ""
          string
            text.as-bytes.slice bstart blen
  if. > [^ctx index csize valid] >> increase
    gt.
      index.plus csize
      size
    T
      "Expected %d byte character at %d index, but there are not enough bytes for it: %x".printf
        *
          csize
          index
          ctx.text.as-bytes
    valid.if
      index.plus csize
      T
        "Malformed UTF-8 sequence (%x) at %d index".printf
          *
            ctx.text.as-bytes.slice index csize
            index
  text.as-bytes.size >> size!

  eq. ++> can-slice-a-line-break-escape-sequence
    "\n".slice
      0
      "\n".length
    "\n"

  eq. ++> can-slice-a-unicode-escape-sequence
    "Ф".slice
      0
      "Ф".length
    "Ф"

  eq. ++> can-slice-an-empty-string
    "".slice
      0
      0
    ""

  eq. ++> can-slice-at-the-end-with-a-zero-length
    "hello".slice
      5
      0
    ""

  eq. ++> can-slice-foreign-literals
    "hello, 大家!".slice
      7
      1
    "大"

  eq. ++> can-slice-four-byte-characters
    "One 😀 and 😀 another".slice
      3
      8
    " 😀 and 😀"

  eq. ++> can-slice-from-the-end
    "hello".slice
      4
      1
    "o"

  eq. ++> can-slice-from-the-start
    "hello".slice
      0
      1
    "h"

  eq. ++> can-slice-in-the-middle
    "hello".slice
      2
      3
    "llo"

  eq. ++> can-slice-nothing
    "no slice".slice
      0
      0
    ""

  eq. ++> can-slice-the-origin-string
    "Hello, world!".slice
      7
      5
    "world"

  eq. ++> can-slice-three-byte-characters
    "The अ is अ".slice
      1
      6
    "he अ i"

  eq. ++> can-slice-two-byte-characters
    "привет".slice
      1
      2
    "ри"

  slice. --> rejects-a-non-continuation-after-a-three-byte-lead-when-slicing
    string E1-80-41
    0
    1

  slice. --> rejects-a-utf-16-surrogate-encoding
    string ED-A0-80
    0
    1

  slice. --> rejects-an-overlong-two-byte-encoding-when-slicing
    string C0-80
    0
    1

  slice. --> stops-on-a-fractional-length
    "some"
    0
    1.5

  slice. --> stops-on-a-fractional-start
    "some"
    0.5
    1

  slice. --> stops-on-a-start-below-zero
    "some string"
    -1
    1

  slice. --> stops-on-a-start-beyond-the-long-range
    "some string"
    1.0e30
    1

  slice. --> stops-on-an-end-below-the-start
    "some string"
    2
    -1

  slice. --> stops-on-an-end-beyond-the-length
    "some string"
    7
    5

  slice. --> stops-on-an-end-beyond-the-long-range
    "some string"
    1
    1.0e30

  slice. --> stops-on-an-infinite-length
    "some"
    0
    pinf

  slice. --> stops-on-an-infinite-start
    "some"
    pinf
    1
