# Returns concatenation of the string with all `other` strings.
# Here `others` must be a `tuple` of `strings`.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^ others] > chained
  if. > @
    0.eq others.length
    ^
    string
      others.reduced
        ^.as-bytes
        accum.concat str.as-bytes > [accum str]

  eq. ++> can-chain-with-other-strings
    "Hello, world!"
    "Hello".chained
      *
        ", "
        "world"
        "!"

  eq. ++> can-return-the-same-text-without-other-strings
    "Some"
    "Some".chained
      *
