# Returns the string trimmed from left side.
# Removes all leading ASCII whitespace bytes: `20-` (space), `09-`
# (horizontal tab), `0A-` (line feed), `0B-` (vertical tab), `0C-`
# (form feed), and `0D-` (carriage return). This is the strip-set
# `String.strip()` uses in Java for the ASCII range, except the four
# separators `1C-` to `1F-`, which stay.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^text] > trimmed-left
  if. > @
    0.eq len
    text
    string
      slice.
        text >> b!
        number
          first-non-ws-index 0 >> idx!
        minus.
          number b.size! >> len
          number idx
  [^text index] >> first-non-ws-index
    if. > @
      len.eq index
      index
      if.
        is-ws (b.slice index 1)!
        text.first-non-ws-index (index.plus 1).as-number
        index
  or. > [c] >> is-ws
    c.eq 20-
    or.
      c.eq 09-
      or.
        c.eq 0A-
        or.
          c.eq 0B-
          or.
            c.eq 0C-
            c.eq 0D-

  "\rvalue".trimmed-left.eq "value" ++> can-trim-a-leading-carriage-return

  "\fvalue".trimmed-left.eq "value" ++> can-trim-a-leading-form-feed

  "\nvalue".trimmed-left.eq "value" ++> can-trim-a-leading-line-feed

  "\tvalue".trimmed-left.eq "value" ++> can-trim-a-leading-tab

  "     ".trimmed-left.eq "" ++> can-trim-a-text-of-leading-spaces-only

  "".trimmed-left.eq "" ++> can-trim-an-empty-text-from-the-left

  "     some".trimmed-left.eq "some" ++> can-trim-many-leading-spaces

  " \t\n\f\rvalue".trimmed-left.eq "value" ++> can-trim-mixed-leading-whitespace

  " s".trimmed-left.eq "s" ++> can-trim-one-leading-space-from-the-left
