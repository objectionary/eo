# Returns the string trimmed from both sides.
# Removes all leading and trailing ASCII whitespace bytes: `20-`
# (space), `09-` (horizontal tab), `0A-` (line feed), `0B-` (vertical
# tab), `0C-` (form feed), and `0D-` (carriage return). Delegates to
# `string.trimmed-left` and `string.trimmed-right`, so the strip-set matches
# `String.strip()` in Java for the ASCII range.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^] > trimmed
  if. > @
    0.eq ^.as-bytes.size
    ^
    ^.trimmed-right.trimmed-left

  "no-whitespace".trimmed.eq "no-whitespace" ++> can-preserve-inner-content

  "\t hello world \n".trimmed.eq "hello world" ++> can-preserve-inner-whitespace

  "        ".trimmed.eq "" ++> can-trim-a-text-of-spaces-only

  "".trimmed.eq "" ++> can-trim-an-empty-text

  "    some     ".trimmed.eq "some" ++> can-trim-many-surrounding-spaces

  eq. ++> can-trim-mixed-whitespace-on-both-sides
    " \t\n\f\rvalue \t\n\f\r".trimmed
    "value"

  " some".trimmed.eq "some" ++> can-trim-one-leading-space

  " some ".trimmed.eq "some" ++> can-trim-one-space-on-both-sides

  "some ".trimmed.eq "some" ++> can-trim-one-trailing-space
