# Object `printf` allows you to format and output text depending
# on the arguments passed to it and return it as `string`.
#
# A specifier reads as `%[N$][flags][width][.precision]conversion`, where
# `N$` picks the `N`-th argument (1-based) instead of the next sequential
# one, `-` justifies to the left, `0` pads a number with leading zeros,
# `width` is the minimum count of characters and `.precision` truncates
# the text (or, for `%f`, counts the fraction digits).
#
# When arguments are processed - they're dataized and converted to objects
# depending on next flags:
# - %s - converts object to `string`
# - %d - converts object to `int`
# - %f - converts object to `float`
# - %x - converts object to `bytes`
# - %b - converts object to boolean, `true` or `false`.
#
# The format is walked over its bytes, and not over its characters, because
# `%` never occurs inside a UTF-8 multi-byte sequence, so a literal byte is
# copied through untouched and the walk stays linear in allocation.
#
# The format is traversed exactly once by `walk`, which copies a literal
# byte and steps forward. At every `%` it asks `spec`, the object
# `string.printf.spec` in its own file, to read one specifier, and then
# continues from the position `spec` reports as `next`, with the argument
# counter `spec` reports as `counter`, appending the text `spec` reports
# as `piece`. Since `spec` needs the argument it formats, and only `spec`
# knows which argument the specifier picks, `walk` makes `spec` twice:
# once without the argument, to read `idx`, and once with it.
#
# The attributes `raw`, `span`, and `given` are public, because `spec`,
# living in another file, reads the format and the count of arguments
# through them.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+unlint sprintf-constant-args
+unlint sprintf-without-formatters
+unlint wrong-sprintf-arguments
+version 0.0.0

[^text args] > printf
  string > @
    [^text index auto acc] >> walk
      if. > @
        gt.
          number text.span
          number
            index >> cursor!
        if.
          25-.eq
            slice. >> char!
              bytes text.raw
              number cursor
              1
          text.walk
            next.
              text.spec >> step
                number cursor
                auto
                text.args.at
                  idx.
                    text.spec (number cursor) auto
            step.counter
            acc.concat step.piece
          text.walk
            plus.
              number cursor
              1
            auto
            acc.concat char
        acc
    | 0 0 --
  args.length > given
  text.as-bytes > raw!
  size. > span!
    bytes raw

  eq. ++> can-answer-the-length-of-the-formatted-text
    2
    length.
      "%s".printf
        * "ab"

  eq. ++> can-answer-the-size-of-the-formatted-text
    size.
      "Hello, %s".printf
        * "Jeff"
    11

  eq. ++> can-count-the-given-arguments
    given.
      "%s %s".printf
        * 1 2
    2

  eq. ++> can-format-a-computed-string
    "abcd"
    "%s".printf
      *
        "ab".concat "cd"

  eq. ++> can-format-objects-of-every-type
    "string Jeff, bytes 4A-65-66-66, float 42.300000, int 14, bool false"
    "string %s, bytes %x, float %f, int %d, bool %b".printf
      *
        "Jeff"
        "Jeff".as-bytes
        42.3
        14
        false

  eq. ++> can-format-the-length-of-another-formatted-text
    "2"
    "%d".printf
      *
        length.
          "%s".printf
            * "ab"

  eq. ++> can-ignore-extra-arguments
    "Hey"
    "%s".printf
      * "Hey" "Jeff"

  eq. ++> can-keep-the-raw-format
    raw.
      "a%sb".printf
        * 1
    "a%sb".as-bytes

  eq. ++> can-measure-the-span-of-the-format
    span.
      "a%sb".printf
        * 1
    4

  eq. ++> can-preserve-an-escaped-bytes-format
    "%x"
    "%%x".printf
      *

  eq. ++> can-print-a-complex-string
    "Привет 3.140000 Jeff X!"
    "Привет %f %s %s!".printf
      *
        3.14
        "Jeff"
        "X"

  eq. ++> can-print-a-percent-sign
    "%Jeff"
    "%%%s".printf
      * "Jeff"

  eq. ++> can-print-a-simple-string
    "Hello, Jeffrey!"
    "Hello, %s!".printf
      * "Jeffrey"
