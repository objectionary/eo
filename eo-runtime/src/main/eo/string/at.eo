# Retrieve symbol by given index as `string`.
# A negative `index` counts from the end of the string (`length + index`).
# If `index` is not a finite integer (fractional, nan or infinite),
# it terminates. If the resolved index is negative or is >= the string's
# `length`, `fallback` is returned.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^text i fallback] > at
  idx.is-integer.not.if > @
    T
      idx.is-finite.if
        "Index must be an integer, but was %f".printf
          * idx
        "Index must be an integer, but was %s".printf
          *
            string
              as-scientific.
                number i! >> idx
    if.
      or.
        0.gt index
        gte.
          number >> index
            if. >>!
              0.gt idx
              plus.
                number text.length! >> len
                idx
              idx
          len
      fallback
      text.slice index 1

  eq. ++> can-recover-from-a-negative-out-of-bounds-index
    "recovered"
    "some".at
      -10
      "recovered"

  eq. ++> can-recover-from-an-out-of-bounds-index
    "recovered"
    "some".at
      10
      "recovered"

  eq. ++> can-return-a-character-at-a-negative-index
    "m"
    "some".at -2

  eq. ++> can-return-a-character-with-a-terminator-for-the-fallback
    "m"
    "some".at
      2
      T

  eq. ++> can-return-the-first-character
    "s"
    "some".at 0

  eq. ++> can-return-the-third-character
    "m"
    "some".at 2

  at. --> stops-on-a-fractional-index
    "some"
    1.5
    "recovered"

  at. --> stops-on-a-nan-index
    "some"
    nan
    "recovered"

  at. --> stops-on-a-negative-fractional-index
    "some"
    -1.5
    "recovered"

  at. --> stops-on-a-negatively-infinite-index
    "some"
    ninf
    "recovered"

  at. --> stops-on-a-positively-infinite-index
    "some"
    pinf
    "recovered"

  "some".at 10 --> stops-on-an-index-beyond-the-length
