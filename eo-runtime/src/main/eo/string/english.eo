# English locale wrapping a `string` and exposing case conversion for it.
# Being a decorator of its `s` string, an `english` object behaves like the
# string itself (`.length`, `.eq`, `.slice` and so on pass through), while
# adding `lower` and `upper` that map the ASCII letters `A`-`Z` and `a`-`z`
# to their counterparts one-to-one. Every other byte, including accented
# Latin, Cyrillic and Greek letters and all multi-byte UTF-8 sequences,
# passes through unchanged. This is the language-neutral default, which is
# equivalent to English since English has no special casing rules. Locales
# that diverge from it, such as `string.turkish`, specialize this object.
# Each conversion hoists its lower letter bound into a `mincode` constant, so
# the bound is computed once rather than for every byte walked.

+alias tuple.reduced
+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[s] > english
  s > @
  [] > lower
    string > @
      reduced
        s.as-bytes.array
        --
        [accum byte] >>
          accum.concat > @
            if.
              and.
                code.lte (as-ascii "Z")!
                code.gte mincode
              slice.
                as-bytes.
                  as-i64.
                    code.plus
                      minus.
                        as-ascii "a"
                        number mincode
                7
                1
              byte
          as-ascii byte > code
    as-ascii "A" >> mincode!
  [] > upper
    string > @
      reduced
        s.as-bytes.array
        --
        [accum byte] >>
          accum.concat > @
            if.
              and.
                code.lte (as-ascii "z")!
                code.gte mincode
              slice.
                as-bytes.
                  as-i64.
                    code.minus
                      minus.
                        number mincode
                        as-ascii "A"
                7
                1
              byte
          as-ascii byte > code
    as-ascii "a" >> mincode!

  eq. ++> can-behave-like-the-wrapped-english-string
    5
    length.
      english "hello"

  eq. ++> can-convert-already-lower-cased-text
    "hello"
    lower.
      english "HeLlO"

  eq. ++> can-convert-already-upper-cased-text
    "HELLO"
    upper.
      english "HeLlO"

  eq. ++> can-convert-text-to-lower-case
    "hello"
    lower.
      english "HELLO"

  eq. ++> can-convert-text-to-upper-case
    "HELLO"
    upper.
      english "hello"

  eq. ++> can-keep-already-lower-cased-text
    "hello"
    lower.
      english "hello"

  eq. ++> can-keep-already-upper-cased-text
    "HELLO"
    upper.
      english "HELLO"

  eq. ++> can-keep-non-ascii-letters-when-lower-casing-in-english
    "ÄÖÜ"
    lower.
      english "ÄÖÜ"

  eq. ++> can-keep-non-ascii-letters-when-upper-casing-in-english
    "äöü"
    upper.
      english "äöü"
