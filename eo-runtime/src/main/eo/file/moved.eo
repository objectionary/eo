# Moves a file to `target` on the filesystem, returning the file at its new
# location. It is a method of `file`, taken off the file it moves.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package file
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^ target] > moved
  if. > @
    renamed.code.eq 0
    file target
    T
      "Cant move the file '%s' to '%s': %s".printf
        *
          ^.path
          target
          renamed.output
  called. > renamed
    os.is-windows.if
      win32 *1
        "rename"
        ^.path
        target
      posix *1
        "rename"
        ^.path
        target

  ++> can-move-a-directory
    and. > @
      exists.
        d.as-file.moved
          "%s.dest".printf
            * d
      d.as-file.exists.not
    mktemp.tmpfile.deleted.as-path.as-dir.made.as-path > d

  ++> can-move-a-file
    and. > @
      exists.
        temp.moved
          "%s.dest".printf
            * temp.path
      temp.exists.not
    mktemp.tmpfile > temp

  ++> can-overwrite-an-existing-destination-on-moving
    os.is-windows.or > @
      and.
        exists.
          source.moved target.path
        "first".eq
          malloc.of
            5
            [^ m]
              seq * > @
                Q.target.open
                  "r"
                  ^.m.put > [^ f] >>
                    f.read 5
                m
    mktemp.tmpfile.open > source
      "w"
      f.write "first" > [^ f]
    mktemp.tmpfile.open > target
      "w"
      f.write "second" > [^ f]

  ++> can-preserve-content-after-moving
    "Hello, world".eq > @
      malloc.of
        12
        [^ m]
          seq * > @
            open.
              Q.temp.moved
                "%s.dest".printf
                  * Q.temp.path
              "r"
              ^.m.put > [^ f] >>
                f.read 12
            m
    mktemp.tmpfile.open > temp
      "w"
      f.write > [^ f]
        "Hello, world"

  mktemp.tmpfile.deleted.moved --> stops-on-moving-an-absent-file
    "irrelevant-target"
