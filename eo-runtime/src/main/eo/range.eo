# Range - create a `list` containing a range of elements
# Here `origin` must be an abstract object that must have an object `next` to
# get next element and object `lt` to compare with the `limit` object.
# Every next element also must have objects `next` and `lt`.
# The first object in the chain must have a default value
# e.g.:
#
# ```
# range
#   []
#     [num] > build
#       num > @!
#       build (num.plus 1) > next
#     build 1 > @
#   10
# ```
#
# Here the first argument is an abstract object that has a default value - 1 and
# it also has object `next`. The next object after first is decorator of
# `1.plus 1` and also has object `next`. Since these objects are ints - they have
# object `lt` by default.
#
# The range gives `origin` and `limit` out as `start` and `end`, and other
# objects, `naturals` among them, read them through those names.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[origin limit] > range
  if. > @
    origin.lt limit
    if. > [^range acc current] >> appended
      current.lt range.limit
      range.appended
        acc.with current
        current.next
      acc
    |
      * origin
      origin.next
    *
  limit > end
  origin > start

  ++> can-build-a-range-from-one-to-ten
    eq. > @
      range
        []
          build 1 > @
          [^ i] > build
            i > @
            ^.build > next
              1.plus i
        10
      *
        1
        2
        3
        4
        5
        6
        7
        8
        9

  ++> can-build-a-range-of-floats-from-one-to-five
    eq. > @
      range
        []
          x 1 > @
          [^ i] > x
            i > @
            ^.x > next
              0.5.plus i
        5
      *
        1
        1.5
        2
        2.5
        3
        3.5
        4
        4.5

  ++> can-build-a-range-with-out-of-bounds-items
    eq. > @
      range
        []
          b 1 > @
          [^ num] > b
            num > @
            ^.b > next
              5.plus num
        10
      * 1 6

  ++> can-build-an-empty-range-from-wrong-items
    is-empty. > @
      range
        []
          y 10 > @
          [num] > y
            num > @
            [] > next
              42 > nothing
        1

  eq. ++> can-give-out-its-end
    end.
      range 3 10
    10

  eq. ++> can-give-out-its-start
    start.
      range 3 10
    3
