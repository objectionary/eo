      0
      [acc] >>
        malloc.for > @
          0
          [iter] >>
            while > @
              max.gt iter > [i] >>
              seq * > [i] >>
                acc.put
                  acc.as-number.plus
                    array.at iter
                iter.put
                  iter.as-number.plus 1
    array.length.plus -1 > max

