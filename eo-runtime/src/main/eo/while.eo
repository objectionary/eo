# Loop `while` with a pre-condition.
# Here's how you can use it:
# ```
# while > last
#   i.lt 5 > [^ i]
#   [i]
#     "Iteration %d\n".printf > @
#       * i
# ```
#
# Here the behaviour of `while` would be identical to:
# ```
# seq > last
#   *
#     dataized "Iteration 0\n"
#     dataized "Iteration 1\n"
#     dataized "Iteration 2\n"
#     dataized "Iteration 3\n"
#     dataized "Iteration 4\n"
# ```
#
# Only the first four strings are dataized for side effects while the last one
# is returned as the result value assigned to the `last` object.
# The `while` loop example produces identical behavior.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[condition body] > while
  if. > @
    as-bool.
      condition 0
    [^spec index] >> loop
      seq * > @
        current
        if.
          as-bool.
            spec.condition next
          spec.loop next
          current
      dataized > current!
        spec.body index
      index.plus 1 > next
    | 0
    false

  ++> can-dataize-only-the-first-cycle
    0.eq > @
      malloc.for
        42
        [x]
          while > @
            i.eq 0 > [i]
            ^.x.put i > [^ i] >>

  ++> can-iterate-a-tuple-with-an-external-iterator
    eq. > @
      malloc.for
        0
        [^ x] >>
          malloc.for > @
            0
            [^ x] >>
              while > @
                ^.^.^.array.length.gt ^.x > [^ i] >>
                seq * > [^ i] >>
                  ^.^.x.put
                    ^.^.x.as-number.plus (^.^.^.array.at ^.x)
                  ^.x.put
                    ^.x.as-number.plus 1
      array.length
    * > array
      1
      1
      1
      1

  ++> can-iterate-a-tuple-with-an-internal-iterator
    eq. > @
      malloc.for
        0
        [^ x] >>
          malloc.for > @
            0
            [^ x] >>
              if. > @
                ^.^.array.length.eq 0
                ^.x.put
                  ^.x.as-number.plus
                    ^.^.array.at 0
                while
                  ^.^.^.array.length.gt ^.x > [^ i] >>
                  seq * > [^ i] >>
                    ^.^.x.put
                      ^.^.x.as-number.plus (^.^.^.array.at i)
                    ^.x.put (^.x.as-number.plus 1)
      array.length
    * > array
      1
      1
      1
      1

  ++> can-iterate-a-tuple-without-a-body-many-times
    eq. > @
      malloc.for
        0
        [^ x] >>
          malloc.for > @
            0
            [^ x] >>
              seq * > @
                while
                  if. > [^ i] >>
                    ^.^.^.array.length.gt ^.x
                    seq *
                      ^.^.x.put
                        ^.^.x.as-number.plus (^.^.^.array.at ^.x.as-number)
                      ^.x.put (^.x.as-number.plus 1)
                      true
                    false
                  true > [i]
                ^.x
      array.length
    * > array
      1
      1
      1

  ++> can-iterate-a-tuple-without-a-body-once
    eq. > @
      malloc.for
        0
        [^ x] >>
          malloc.for > @
            0
            [^ x] >>
              seq * > @
                while
                  if. > [^ i] >>
                    ^.^.^.array.length.gt ^.x
                    seq *
                      ^.^.x.put
                        ^.^.x.as-number.plus (^.^.^.array.at ^.x.as-number)
                      ^.x.put (^.x.as-number.plus 1)
                      true
                    false
                  true > [i]
                ^.x
      array.length
    * 1 > array

  ++> can-loop-on-a-bool-expression-kept-in-malloc
    eq. > @
      malloc.for
        true
        [x]
          while > @
            ^.x > [^ i] >>
            ^.x.put false > [^ i] >>
      false

  ++> can-loop-over-a-simple-iteration
    eq. > @
      malloc.for
        0
        [x]
          while > @
            i.lt 10 > [i]
            ^.x.put i > [^ i] >>
      9

  not. ++> can-loop-when-the-condition-is-false-first
    while
      false > [i]
      true > [i]

  ++> can-return-the-last-dataized-object
    eq. > @
      malloc.for
        0
        [x]
          while > @
            2.gt ^.x > [^ i] >>
            ^.x.put > [^ i] >>
              ^.x.as-number.plus 1
      2

  not. ++> can-return-the-last-dataized-object-with-a-false-condition
    while
      1.gt 2 > [i]
      true > [i]

  ++> can-run-a-memory-controlled-body-only-once
    1.eq > @
      malloc.for
        0
        [^ x]
          while > @
            ^.x.as-number.eq 0 > [^ i] >>
            ^.x.put > [^ i] >>
              ^.x.as-number.plus 1

  ++> can-run-hundreds-of-cycles
    199.eq > @
      malloc.for
        0
        [x]
          while > @
            i.lt 200 > [i]
            ^.x.put i > [^ i] >>

  ++> can-stop-before-a-body-whose-memory-condition-is-false
    6.eq > @
      malloc.for
        2
        [^ x]
          while > @
            ^.x.as-number.lt 6 > [^ i] >>
            ^.x.put > [^ i] >>
              ^.x.as-number.plus 1
