      malloc.for
        0
        [m]
          while > @
            2.gt m > [i] >>
            m.put > [i] >>
              m.as-number.plus 1
      3

  not. ++> can-return-the-last-dataized-object-with-a-false-condition
    while
      1.gt 2 > [i]
      true > [i]
