      0
      seq * > [m]
        socket.guarded
          m.put
            m.as-number.plus 1
          true
        m.as-number
    1

  eq. ++> can-guard-a-scope-and-behave-as-it
    socket.guarded
      42
      true
    42

  ++> can-report-a-connection-nobody-accepts
