      connect.
        socket "127.0.0.1" 1
        talking
        refused
    true > [message] > refused
    false > [client] > talking

  ++> can-resend-the-remaining-bytes-after-a-short-send
    eq. > @
      malloc.of
        2
        [c]
          seq * > @
            write.
              socket.as-output
                partial-send c
              01-02
            c.get
          seq * > [acc buffer] > partial-send
            acc.write
              2.minus buffer.size
              buffer.slice 0 1
            1
      01-02

  eq. ++> can-run-a-guard-cleanup-after-a-successful-scope
    malloc.for
      0
      seq * > [m]
        socket.guarded
          42
          m.put
            m.as-number.plus 1
        m.as-number
    1

  eq. ++> can-run-a-guard-cleanup-after-a-terminated-scope
    malloc.for
      0
      seq * > [m]
        recovered
          socket.guarded
            2.as-i64.div 0.as-i64
            m.put
              m.as-number.plus 1
          true
        m.as-number
    1

  checked-port. --> rejects-a-fractional-port
