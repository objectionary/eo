# Tuple.
# An ordered, immutable collection of elements.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[prior last count] > tuple
  [^list i fallback] > at
    if. > @
      or.
        not.
          index.floor.eq index
        or.
          0.gt
            number >> index
              if. >>!
                0.gt
                  number i! >> idx
                list.length.plus idx
                idx
          list.length.lte index
      fallback failure
      if. > [^list tup] >> at-fast
        0.eq tup.length
        list.fallback list.failure
        if.
          eq.
            tup.length.plus -1
            index
          tup.head
          list.at-fast tup.tail
      | list
    printf. >> failure
      if.
        index.floor.eq index
        "Given index %s is out of tuple bounds"
        "Index must be an integer, but was %s"
      *
        i.is-finite.if
          "%f".printf
            * i
          string i.as-scientific
  tuple > empty
    T "Can't get tail from the empty tuple"
    T "Can't get head from the empty tuple"
    0
  [^list other] > eq
    and. > @
      list.length.eq other.length
      if. > [^list first second] >> receq
        first.length.eq 0
        true
        if.
          first.head.eq second.head
          list.receq first.tail second.tail
          false
      | list other
  last > head
  count > length
  prior > tail
  tuple > [^list x] > with
    list
    x
    as-number.
      list.length.plus 1

  ++> can-add-an-item
    and. > @
      and.
        and.
          eq.
            array.at 0
            1
          eq.
            array.at 1
            2
        eq.
          array.at 2
          3
      eq.
        array.at 3
        "with"
    with. > array
      *
        1
        2
        3
      "with"

  ++> can-be-a-bound-attribute-of-one-item
    eq. > @
      tup.at 0
      100
    * 100 > tup

  ++> can-be-a-bound-attribute-of-two-items
    and. > @
      eq.
        array.at 0
        1
      eq.
        array.at 1
        2
    * > array
      1
      2

  ++> can-be-a-bound-attribute-when-empty
    tup.length.eq 0 > @
    * > tup

  ++> can-build-a-tuple-fluently
    and. > @
      and.
        eq.
          array.at 0
          1
        eq.
          array.at 1
          2
      eq.
        array.at 2
        3
    with. > array
      with.
        tuple.empty.with 1
        2
      3

  ++> can-build-a-tuple-fluently-when-indented
    and. > @
      and.
        eq.
          array.at 0
          1
        eq.
          array.at 1
          2
      eq.
        array.at 2
        3
    with. > array
      with.
        tuple.empty.with 1
        2
      3

  ++> can-build-an-empty-tuple-with-an-indented-keyword
    and. > @
      and.
        eq.
          array.at 0
          1
        eq.
          array.at 1
          2
      eq.
        array.at 2
        3
    with. > array
      with.
        tuple.empty.with 1
        2
      3

  eq. ++> can-concat-with-another-tuple
    concat.
      * 0 1
      * 2 3
    *
      0
      1
      2
      3

  ++> can-create-an-empty-tuple-with-a-number
    eq. > @
      a.at 0
      3
    tuple.empty.with 3 > a

  eq. ++> can-equal-a-nested-tuple
    *
      * 0 1
      * 4 0
      * 7 3
    *
      * 0 1
      * 4 0
      * 7 3

  eq. ++> can-equal-another-tuple
    *
      1
      2
      3
    *
      1
      2
      3

  ++> can-get-the-length-of-an-empty-tuple
    a.length.eq 0 > @
    * > a

  tuple.empty.length.eq ++> can-get-the-length-of-an-empty-tuple-through-special-syntax
    0

  tuple.empty.length.eq ++> can-get-the-length-of-an-empty-tuple-without-an-extra-object
    0

  eq. ++> can-make-a-tuple-through-special-syntax
    length.
      * 1 2
    2

  eq. ++> can-recover-from-a-fractional-index
    "recovered"
    at.
      *
        "zero"
        "one"
        "two"
      1.5
      "recovered" > [message]

  eq. ++> can-recover-from-an-out-of-bounds-index
    "recovered"
    at.
      *
        1
        2
        3
        4
      20
      "recovered" > [message]

  ++> can-report-the-length-of-a-non-empty-tuple
    eq. > @
      length.
        elements.
          array *
            "a"
            "b"
            "c"
            "d"
            "e"
      5
    [items] > array
      items > elements

  ++> can-report-the-length-of-an-empty-tuple
    eq. > @
      length.
        elements.
          array
            *
      0
    [items] > array
      items > elements

  ++> can-take-the-first-item-by-a-negative-index
    eq. > @
      array.at -5
      0
    * > array
      0
      1
      2
      3
      4

  ++> can-take-the-last-item-by-a-negative-index
    eq. > @
      array.at -1
      4
    * > array
      0
      1
      2
      3
      4

  not. ++> can-tell-it-does-not-equal-a-different-tuple
    eq.
      *
        1
        2
        3
      *
        3
        2
        1

  at. --> stops-on-a-wrong-index
    *
      1
      2
      3
      4
    20

  --> stops-on-an-out-of-bounds-negative-index
    array.at -6 > @
    * > array
      0
      1
      2
      3
      4

  tuple.empty.head --> stops-on-taking-the-head-of-an-empty-tuple

  tuple.empty.tail --> stops-on-taking-the-tail-of-an-empty-tuple

  ++> can-reject-a-fractional-index-without-reading-the-tail
    eq. > @
      "Index must be an integer, but was 1.500000"
      tup.at 1.5 I
    tuple > tup
      T "The tail must not be inspected"
      "last"
      3

  eq. ++> can-report-a-negative-fractional-index
    "Index must be an integer, but was -1.500000"
    at.
      * 1 2 3
      -1.5
      I

  eq. ++> can-report-a-nan-index
    "Index must be an integer, but was nan"
    at.
      * 1 2 3
      nan
      I

  eq. ++> can-report-an-infinite-index
    "Given index infinity is out of tuple bounds"
    at.
      * 1 2 3
      pinf
      I

  eq. ++> can-report-an-out-of-bounds-negative-index
    "Given index -4.000000 is out of tuple bounds"
    at.
      * 1 2 3
      -4
      I
