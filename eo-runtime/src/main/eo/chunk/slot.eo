# Bounded view over a region of an existing chunk.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package chunk
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^ start length] > slot
  window > @
    ^
    start
    length
  [^ parent start length] > window
    get > @
    [^ source target count] > copy
      seq * > @
        ^.read source count >> data!
        ^.write target data
    read > get
      0
      size
    parent.id > id
    if. > [^ object] > put
      and.
        ^.size.gt 0
        object.size.gt ^.size
      T
        "Can't put %d bytes into a chunk sized %d bytes; call .resized first to grow it".printf
          * object.size ^.size
      ^.write 0 object
    if. > [^ offset length cant-read] > read
      ^.valid.and
        and.
          0.lte offset
          lte.
            offset.plus length
            ^.length
      ^.parent.read
        ^.start.plus offset
        length
      cant-read
        "Can't read %f bytes from slot offset %f, because the slot has length %f".printf
          * length offset ^.length
    T > [^ capacity] > resized
      "Can't resize a chunk slot of length %f".printf
        * ^.length
    ^.valid.if > [^] > size
      ^.length
      T "Can't get the size of an invalid chunk slot"
    ^.^.window > [^ begin width] > slot
      ^
      begin
      width
    ^.parent.valid.if > [^] > valid
      and.
        and.
          and.
            ^.start.is-finite.and ^.start.is-integer
            0.lte ^.start
          and.
            ^.length.is-finite.and ^.length.is-integer
            0.lte ^.length
        lte.
          ^.start.plus ^.length
          ^.parent.size
      false
    if. > [^ offset data] > write
      ^.valid.and
        and.
          0.lte offset
          lte.
            offset.plus data.size
            ^.length
      ^.parent.write
        ^.start.plus offset
        data
      T
        "Can't write %f bytes at slot offset %f, because the slot has length %f".printf
          * data.size offset ^.length

  ++> can-compose-offsets-through-three-nested-slots
    eq. > @
      malloc.of
        32
        [mem]
          seq * > @
            outer
            middle
            inner
            inner.put 0A-0B-0C-0D
            mem.read 9 4
          middle.slot 3 8 > inner
          outer.slot 2 12 > middle
          mem.slot 4 20 > outer
      0A-0B-0C-0D

  ++> can-copy-bytes-inside-a-slot
    eq. > @
      malloc.of
        8
        [mem]
          seq * > @
            part
            part.write 0 01-02
            part.copy 0 2 2
            part.read 0 4
          mem.slot 2 4 > part
      01-02-01-02

  ++> can-create-a-slot-with-parent-id
    malloc.of > @
      16
      [mem]
        and. > @
          part.size.eq 4
          part.id.eq mem.id
        mem.slot 2 4 > part

  eq. ++> can-have-a-zero-length-slot
    malloc.of
      8
      size. > [mem]
        mem.slot 8 0
    0

  ++> can-invalidate-nested-child-after-root-shrink
    not. > @
      malloc.of
        16
        [mem]
          seq * > @
            child
            mem.resized 8
            child.valid
          slot. > child
            mem.slot 4 8
            0
            4

  ++> can-isolate-neighbouring-slots
    eq. > @
      malloc.of
        8
        [mem]
          seq * > @
            left
            right
            left.put 01-02-03-04
            right.put 05-06-07-08
            and.
              left.get.eq 01-02-03-04
              right.get.eq 05-06-07-08
          mem.slot 0 4 > left
          mem.slot 4 4 > right
      true

  ++> can-propagate-parent-validity-after-resize
    eq. > @
      malloc.of
        16
        [mem]
          seq * > @
            parent.valid.and child.valid
            mem.resized 8
            parent.valid.not.and child.valid.not
          parent.slot 0 4 > child
          mem.slot 4 8 > parent
      true

  ++> can-read-a-slot-with-a-terminator-for-the-error
    eq. > @
      malloc.of
        8
        [mem]
          seq * > @
            part
            part.write 0 01-02
            part.write 2 03-04
            part.read 0 4 T
          mem.slot 2 4 > part
      01-02-03-04

  ++> can-read-and-write-at-slot-edges
    eq. > @
      malloc.of
        8
        [mem]
          seq * > @
            part
            part.write 0 01-02
            part.write 2 03-04
            part.read 0 4
          mem.slot 2 4 > part
      01-02-03-04

  eq. ++> can-recover-from-reading-past-the-slot-end
    malloc.of
      8
      read. > [mem]
        mem.slot 2 5
        4
        3
        C3-1F-08 > [x]
    C3-1F-08

  not. ++> can-reject-child-that-exceeds-its-direct-parent
    malloc.of
      16
      valid. > [mem]
        slot.
          mem.slot 0 8
          7
          2

  malloc.of ++> can-reject-invalid-slot-regions
    8
    and. > [mem]
      and.
        not.
          valid.
            mem.slot 1 2.5
        not.
          valid.
            mem.slot -1 2
      and.
        not.
          valid.
            mem.slot pinf 2
        not.
          valid.
            mem.slot 7 2

  malloc.of --> stops-on-resizing-a-slot
    8
    resized. > [mem]
      mem.slot 2 4
      8

  --> stops-on-taking-the-size-of-a-stale-slot
    malloc.of > @
      8
      [mem]
        seq * > @
          part
          mem.resized 2
          part.size
        mem.slot 4 2 > part

  malloc.of --> stops-on-writing-past-the-slot-end
    8
    write. > [mem]
      mem.slot 2 4
      3
      01-02
