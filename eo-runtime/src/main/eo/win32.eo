# Makes a windows syscall by `name`.
#
# The non-socket operations (file, console, process, environment and clock) go
# through the Microsoft C runtime (msvcrt), which exposes POSIX-compatible
# functions returning integer file descriptors, so the win32 objects thread them
# through EO exactly like the posix ones. Sockets stay on Winsock (ws2_32), since
# the C runtime has no BSD sockets. You can look the functions up in the CRT
# reference (https://learn.microsoft.com/en-us/cpp/c-runtime-library/reference)
# and the Winsock reference (https://learn.microsoft.com/en-us/windows/win32/api/winsock2).

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+rt jvm org.eolang:eo-runtime:0.0.0
+rt node eo2js-runtime:0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[name args] > win32
  [] > @ /Q.win32.return
    ? > ^
  [] > accept /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.win32.sockaddr-in
    ? > length /Q.number
  [] > access /Q.number
    ? > path /Q.string
    ? > mode /Q.number
  8 > append
  [] > bind /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.win32.sockaddr-in
    ? > length /Q.number
  [] > close /Q.number
    ? > descriptor /Q.number
  [] > closesocket /Q.number
    ? > descriptor /Q.number
  [] > connect /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.win32.sockaddr-in
    ? > length /Q.number
  256 > creat
  [code name] > dir-return
    win32.dir-return > called
      code
      name
  17 > eexist
  10022 > einval
  [] > errno /Q.number
  1024 > exclusive
  -1 > failure
  [] > find-close /Q.number
    ? > search /Q.number
  [] > find-next-file /Q.win32.dir-return
    ? > search /Q.number
  [] > ftime64-s /Q.win32.time-return
  [] > get-file-attributes /Q.number
    ? > path /Q.string
  [] > getenv /Q.win32.getenv-return
    ? > name /Q.string
  [code value] > getenv-return
    win32.getenv-return > called
      code
      value
  [] > getpid /Q.number
  2 > inet
  [] > inet-addr /Q.number
    ? > address /Q.string
  -1 > invalid
  [] > listen /Q.number
    ? > descriptor /Q.number
    ? > backlog /Q.number
  [] > mkdir /Q.win32.status-return
    ? > path /Q.string
  384 > mode
  -1 > none
  [] > open /Q.win32.status-return
    ? > path /Q.string
    ? > flags /Q.number
    ? > mode /Q.number
  32768 > rdonly
  32770 > rdwr
  [] > read /Q.win32.read-return
    ? > descriptor /Q.number
    ? > size /Q.number
  [code data] > read-return
    data > @
    win32.read-return > called
      code
      data
  [] > recv /Q.win32.read-return
    ? > descriptor /Q.number
    ? > size /Q.number
    ? > flags /Q.number
  [] > rename /Q.win32.status-return
    ? > from /Q.string
    ? > to /Q.string
  00-00-00-00-00-00-04-00 > reparse
  [^ code output] > return
    output > @
    ^.return > called
      code
      output
  [] > rmdir /Q.win32.status-return
    ? > path /Q.string
  [] > send /Q.number
    ? > descriptor /Q.number
    ? > buffer
    ? > size /Q.number
    ? > flags /Q.number
  [family port address] > sockaddr-in
    00-00-00-00-00-00-00-00 > padding
    plus. > size
      plus.
        family.size.plus port.size
        address.size
      padding.size
  [] > socket /Q.number
    ? > domain /Q.number
    ? > type /Q.number
    ? > protocol /Q.number
  [code mode size] > stat-return
    win32.stat-return > called
      code
      mode
      size
  [] > stat64 /Q.win32.stat-return
    ? > path /Q.string
  [code message] > status-return
    win32.status-return > called
      code
      message
  2 > stderr
  0 > stdin
  1 > stdout
  1 > stream
  6 > tcp
  [code seconds micros] > time-return
    win32.time-return > called
      code
      seconds
      micros
  512 > trunc
  [] > unlink /Q.win32.status-return
    ? > path /Q.string
  4294967295 > unresolved
  02-02 > version
  [] > write /Q.number
    ? > descriptor /Q.number
    ? > buffer
    ? > size /Q.number
  32769 > wronly
  [] > wsa-cleanup /Q.number
  [] > wsa-get-last-error /Q.number
  [] > wsa-startup /Q.number
    ? > version /Q.bytes

  os.is-windows.not.or ++> can-accept-the-two-part-form-of-an-address
    eq.
      win32.inet-addr "127.1"
      16777343

  ++> can-close-a-tcp-socket
    os.is-windows.not.or > @
      seq *
        sd
        not.
          eq.
            win32.closesocket sd
            -1
    as-number. > sd
      win32.socket >>!
        win32.inet
        win32.stream
        win32.tcp

  ++> can-compute-the-size-of-a-sockaddr-in
    addr.size.eq 16 > @
    win32.sockaddr-in > addr
      00-00
      00-00
      00-00-00-00

  ++> can-open-a-file-with-the-append-flag
    os.is-windows.not.or > @
      seq *
        win32.close fd
        fd.gt -1
    code. > fd
      win32.open
        "NUL"
        win32.wronly.plus win32.append
        0

  ++> can-open-a-file-with-the-trunc-flag
    os.is-windows.not.or > @
      seq *
        win32.close fd
        fd.gt -1
    code. > fd
      win32.open
        mktemp.tmpfile.as-path
        win32.wronly.plus win32.trunc
        win32.mode

  ++> can-open-a-tcp-socket
    os.is-windows.not.or > @
      seq *
        win32.closesocket sd
        sd.gt 0
    as-number. > sd
      win32.socket >>!
        win32.inet
        win32.stream
        win32.tcp

  os.is-windows.not.or ++> can-read-a-leading-zero-as-octal
