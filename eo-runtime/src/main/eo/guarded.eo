# Scope paired with a cleanup that always runs.
# Dataizes `scope` once and then dataizes `cleanup`, no matter whether the
# dataization of `scope` succeeded or terminated. Behaves as `scope` when it
# is not terminated; when it is, `cleanup` still runs and the termination
# propagates. The value of `scope` is cached before `cleanup` runs, so that
# `cleanup` cannot invalidate what `scope` was dataized from. This is how an
# object that owns a descriptor releases it even when the scope it was handed
# to fails, as `scoped-socket` does when it hands its descriptor to a scope
# and closes it afterwards.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[scope cleanup] > guarded
  seq * > @
    recovered
      value
      true
    cleanup
    value
  scope > value!

  eq. ++> can-behave-as-the-scope
    guarded
      42
      true
    42

  eq. ++> can-dataize-the-scope-once
    malloc.for
      0
      seq * > [m]
        guarded
          m.put
            m.as-number.plus 1
          true
        m.as-number
    1

  eq. ++> can-run-cleanup-after-a-successful-scope
    malloc.for
      0
      seq * > [m]
        guarded
          42
          m.put
            m.as-number.plus 1
        m.as-number
    1

  eq. ++> can-run-cleanup-after-a-terminated-scope
    malloc.for
      0
      seq * > [m]
        recovered
          guarded
            2.as-i64.div 0.as-i64
            m.put
              m.as-number.plus 1
          true
        m.as-number
    1

  guarded --> stops-on-a-terminated-scope
    2.as-i64.div 0.as-i64
    true
