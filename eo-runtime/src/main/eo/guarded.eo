# Object that dataizes `scope` and, whether that dataization succeeds or
# fails, dataizes `cleanup` afterwards. The bytes of `scope` are returned on
# success; on failure `cleanup` still runs and the original failure is
# re-raised.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+rt jvm org.eolang:eo-runtime:0.0.0
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[] > guarded /Q.bytes
  ? > scope
  ? > cleanup

  eq. ++> can-run-cleanup-after-a-successful-scope
    malloc.for
      0
      seq * > [m]
        guarded
          42
          m.put
            m.as-number.plus 1
        m.as-number
    1
