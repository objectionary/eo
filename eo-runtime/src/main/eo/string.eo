# Object `string` represents UTF-8 encoded text strings stored internally
# as byte sequences. It provides Unicode-aware operations for text manipulation
# including slicing, length calculation, and character-level access.
# Unicode characters may occupy 1-4 bytes each, so byte length differs from
# character length for non-ASCII text.
#
# Usage examples:
# ```
# string "Hello, \u4e16\u754c!"  # Unicode string creation
# "text".length                  # Character count (not bytes)
# "text".slice 0 2               # Character-based slicing
# "TEXT".lower                   # Lower case, default English rules
# "text".upper                   # Upper case, default English rules
# "text".turkish.upper           # Upper case, Turkish dotted/dotless I
# ```
# Case conversion is exposed as string methods `lower` and `upper`, backed
# by the locale wrappers `string.english` (the default) and `string.turkish`.
#
# @todo #9025:60min Test a text block and a Unicode escape in EO. The
#  canonical printer writes a text block as a plain string and `\u0424` as
#  the letter it stands for, and the build refuses a file that is not
#  canonical, so the tests named after text blocks and escapes below can
#  only compare the plain string with its bytes. The printer also folds
#  `string` of valid UTF-8 bytes into the literal they spell, so
#  `can-turn-bytes-into-a-string` in `bytes.eo` compares a literal with its
#  bytes as well. Once the printer keeps such literals, or a form it leaves
#  alone is found, write these tests with the literals themselves.
# .

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[@] > string

  not. ++> can-compare-a-string-with-nan
    nan.eq "друг"

  not. ++> can-compare-a-string-with-negative-infinity
    ninf.eq "друг"

  eq. ++> can-compare-a-string-with-positive-infinity
    pinf.eq "друг"
    false

  "Ф".eq "Ф" ++> can-compare-one-symbol-strings

  not. ++> can-compare-two-different-string-types
    "Hello".eq 42

  not. ++> can-compare-two-different-strings
    "Hello".eq
      "Good bye"

  eq. ++> can-compare-two-equal-strings
    "x".eq "x"
    true

  D0-B4-D1-80-D1-83-D0-B3.eq "друг" ++> can-equal-a-string-through-bytes

  "друг".eq D0-B4-D1-80-D1-83-D0-B3 ++> can-equal-bytes

  "Abc".eq "Abc" ++> can-hold-a-one-line-text-block

  eq. ++> can-hold-a-text-block-with-a-margin
    "z\n  y\n x"
    7A-0A-20-20-79-0A-20-78

  "e\ne\ne".eq 65-0A-65-0A-65 ++> can-hold-a-three-line-text-block

  eq. ++> can-preserve-indentation-in-a-text-block
    "a\n b\n  c"
    61-0A-20-62-0A-20-20-63

  "\n".eq 0A- ++> can-support-a-line-break-escape-sequence

  "Ф".eq D0-A4 ++> can-support-a-unicode-escape-sequence

  eq. ++> can-support-escape-sequences
    "Hello, друг!\n"
    48-65-6C-6C-6F-2C-20-D0-B4-D1-80-D1-83-D0-B3-21-0A

  eq. ++> can-support-escape-sequences-in-a-text-block
    "Hello, друг!\n"
    48-65-6C-6C-6F-2C-20-D0-B4-D1-80-D1-83-D0-B3-21-0A

  eq. ++> can-turn-into-bytes
    "€ друг".as-bytes
    E2-82-AC-20-D0-B4-D1-80-D1-83-D0-B3

  eq. ++> can-unescape-slashes
    "x\\b\\f\\u\\r\\t\\n\\'"
    78-5C-62-5C-66-5C-75-5C-72-5C-74-5C-6E-5C-27

  "\b\f\n\r\t⟦".eq 08-0C-0A-0D-09-E2-9F-A6 ++> can-unescape-symbols

  "Hey".missing-attr --> stops-on-taking-a-missing-attribute
