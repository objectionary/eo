# True when collection `list` has no elements.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package tuple
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[^list] > is-empty
  0.eq list.length > @

  tuple.empty.is-empty ++> can-be-empty-when-built-empty

  not. ++> can-tell-it-is-not-empty-with-one-anonymous-object
    is-empty.
      *
        [f]

  not. ++> can-tell-it-is-not-empty-with-one-item
    is-empty.
      * 1 2

  not. ++> can-tell-it-is-not-empty-with-three-objects
    is-empty.
      *
        [x]
        [y]
        [z]
