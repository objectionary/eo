# Makes a Unix syscall by `name` with POSIX interface.
# Here `args` is a `org.eolang.tuple` of arguments required for
# the particular syscall.
# See the linux syscall [table](https://filippo.io/linux-syscall-table) for more info.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+rt jvm org.eolang:eo-runtime:0.0.0
+rt node eo2js-runtime:0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[name args] > posix
  [] > @ /Q.posix.return
    ? > ^
  [] > accept /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.posix.sockaddr-in
    ? > length /Q.number
  [] > access /Q.number
    ? > path /Q.string
    ? > mode /Q.number
  os.is-macos.if > append
    8
    1024
  [] > bind /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.posix.sockaddr-in
    ? > length /Q.number
  [] > close /Q.number
    ? > descriptor /Q.number
  [] > connect /Q.number
    ? > descriptor /Q.number
    ? > sockaddr /Q.posix.sockaddr-in
    ? > length /Q.number
  os.is-macos.if > creat
    512
    64
  [code name] > dir-return
    posix.dir-return > called
      code
      name
  17 > eexist
  22 > einval
  2 > enoent
  [] > errno /Q.number
  os.is-macos.if > exclusive
    2048
    128
  [] > getenv /Q.posix.getenv-return
    ? > name /Q.string
  [code value] > getenv-return
    posix.getenv-return > called
      code
      value
  [] > getpid /Q.number
  [] > gettimeofday /Q.posix.time-return
  2 > inet
  [] > inet-addr /Q.number
    ? > address /Q.string
  [] > listen /Q.number
    ? > descriptor /Q.number
    ? > backlog /Q.number
  [] > lstat /Q.posix.stat-return
    ? > path /Q.string
  420 > mode
  -1 > none
  511 > permissions
  384 > private
  0 > rdonly
  2 > rdwr
  [] > read /Q.posix.read-return
    ? > descriptor /Q.number
    ? > size /Q.number
  [code data] > read-return
    data > @
    posix.read-return > called
      code
      data
  [] > readdir /Q.posix.dir-return
    ? > dirp /Q.number
  [] > recv /Q.posix.read-return
    ? > descriptor /Q.number
    ? > size /Q.number
    ? > flags /Q.number
  [^ code output] > return
    output > @
    ^.return > called
      code
      output
  [] > send /Q.number
    ? > descriptor /Q.number
    ? > buffer
    ? > size /Q.number
    ? > flags /Q.number
  [family port address] > sockaddr-in
    00-00-00-00-00-00-00-00 > padding
    plus. > size
      plus.
        family.size.plus port.size
        address.size
      padding.size
  [] > socket /Q.number
    ? > domain /Q.number
    ? > type /Q.number
    ? > protocol /Q.number
  [] > stat /Q.posix.stat-return
    ? > path /Q.string
  [code mode size] > stat-return
    posix.stat-return > called
      code
      mode
      size
  2 > stderr
  0 > stdin
  1 > stdout
  1 > stream
  [] > strerror /Q.string
    ? > errno /Q.number
  6 > tcp
  [code seconds micros] > time-return
    posix.time-return > called
      code
      seconds
      micros
  os.is-macos.if > trunc
    1024
    512
  4294967295 > unresolved
  [] > write /Q.number
    ? > descriptor /Q.number
    ? > buffer
    ? > size /Q.number
  1 > wronly

  ++> can-close-a-tcp-socket
    os.is-windows.or > @
      seq *
        sd
        not.
          eq.
            posix.close sd
            -1
    as-number. > sd
      posix.socket >>!
        posix.inet
        posix.stream
        posix.tcp

  ++> can-compute-the-size-of-a-sockaddr-in
    addr.size.eq 16 > @
    posix.sockaddr-in > addr
      00-00
      00-00
      00-00-00-00

  os.is-windows.or ++> can-convert-the-limited-broadcast-address-without-an-error
    seq *
      posix.access "/there-is-no-such-path" 0
      posix.inet-addr "255.255.255.255"
      posix.errno.eq posix.enoent

  os.is-windows.or ++> can-invoke-getpid
    posix.getpid.gt 0

  os.is-windows.or ++> can-leave-errno-alone-after-converting-an-address
    seq *
      posix.access "/there-is-no-such-path" 0
      posix.inet-addr "127.0.0.1"
      posix.errno.eq posix.enoent

  ++> can-open-a-file-with-the-append-flag
    os.is-windows.or > @
      seq *
        posix.close fd
        fd.gt -1
    code. > fd
      posix *1
        "open"
        "/dev/null"
        posix.wronly.plus posix.append
        0

  ++> can-open-a-file-with-the-trunc-flag
    os.is-windows.or > @
      seq *
        posix.close fd
        fd.gt -1
    code. > fd
      posix *1
        "open"
        "/dev/null"
        posix.wronly.plus posix.trunc
        0

  ++> can-open-a-tcp-socket
    os.is-windows.or > @
      seq *
        posix.close sd
        sd.gt 0
    as-number. > sd
      posix.socket >>!
        posix.inet
        posix.stream
        posix.tcp

  ++> can-open-and-close-a-file-through-a-syscall
    os.is-windows.or > @
      seq *
        posix.close fd
        fd.gt -1
    code. > fd
      posix *1
        "open"
        "/dev/null"
        0
        0

  os.is-windows.or ++> can-report-an-address-it-cannot-convert-as-invalid
    seq *
      posix.inet-addr "nope"
      posix.errno.eq posix.einval

  os.is-windows.or ++> can-report-eexist-when-creating-an-existing-file-exclusively
    seq *
      code.
        posix *1
          "open"
          "/dev/null"
          plus.
            posix.rdonly.plus posix.creat
            posix.exclusive
          posix.private
      posix.errno.eq posix.eexist

  os.is-windows.or ++> can-return-an-inet-address-above-the-signed-range
    eq.
      posix.inet-addr "10.0.0.200"
      3355443210

  os.is-windows.or ++> can-return-an-inet-address-for-localhost
    eq.
      posix.inet-addr "127.0.0.1"
      16777343

  os.is-windows.or ++> can-return-the-limited-broadcast-address
    eq.
      posix.inet-addr "255.255.255.255"
      posix.unresolved

  eq. ++> can-stand-for-the-bytes-a-read-returned
    posix.read-return
      3
      D0-B6-21
    D0-B6-21

  ++> can-stat-the-size-of-dev-null
    os.is-windows.or > @
      info.size.eq 0
    posix.stat "/dev/null" > info

  ++> can-store-seconds-in-a-time-return
    tv.seconds.eq 5 > @
    posix.time-return > tv
      0
      5
      100

  posix.send --> stops-on-send-size-exceeding-buffer-length
    0
    "ab"
    4096
    0

  --> stops-on-write-size-being-negative
    os.is-windows.if > @
      1.div 0
      seq *
        posix.write
          fd
          "ab"
          -1
        true
    code. > fd
      posix *1
        "open"
        "/dev/null"
        posix.wronly
        0

  --> stops-on-write-size-exceeding-buffer-length
    os.is-windows.if > @
      1.div 0
      seq *
        posix.write
          fd
          "ab"
          4096
        true
    code. > fd
      posix *1
        "open"
        "/dev/null"
        posix.wronly
        0
