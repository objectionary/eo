# Root locale exposing case conversion for text.
# `low-cased` and `up-cased` map the ASCII letters `A`-`Z` and `a`-`z` to
# their counterparts one-to-one; every other byte, including accented
# Latin, Cyrillic and Greek letters and all multi-byte UTF-8 sequences,
# passes through unchanged. This is the language-neutral default, which is
# equivalent to English since English has no special casing rules. Locales
# that diverge from it, such as `locale.turkish`, specialize this object.
# Each object hoists its lower letter bound into a `mincode` constant, so
# the bound is computed once rather than for every byte walked.

+alias tuple.reduced
+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+version 0.0.0
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+unlint mandatory-package

[] > locale
  [text] > low-cased
    string > @
      reduced
        text.as-bytes.array
        --
        [accum byte] >>
          accum.concat > @
            if.
              and.
                code.lte (string.as-ascii "Z")!
                code.gte mincode
              slice.
                as-bytes.
                  as-i64.
                    code.plus
                      minus.
                        string.as-ascii "a"
                        number mincode
                7
                1
              byte
          string.as-ascii byte > code
    string.as-ascii "A" >> mincode!
  [text] > up-cased
    string > @
      reduced
        text.as-bytes.array
        --
        [accum byte] >>
          accum.concat > @
            if.
              and.
                code.lte (string.as-ascii "z")!
                code.gte mincode
              slice.
                as-bytes.
                  as-i64.
                    code.minus
                      minus.
                        number mincode
                        string.as-ascii "A"
                7
                1
              byte
          string.as-ascii byte > code
    string.as-ascii "a" >> mincode!

  eq. ++> can-convert-already-lower-cased-text
    "hello"
    locale.low-cased "HeLlO"

  eq. ++> can-convert-already-upper-cased-text
    "HELLO"
    locale.up-cased "HeLlO"

  eq. ++> can-convert-text-to-lower-case
    "hello"
    locale.low-cased "HELLO"

  eq. ++> can-convert-text-to-upper-case
    "HELLO"
    locale.up-cased "hello"

  eq. ++> can-keep-already-lower-cased-text
    "hello"
    locale.low-cased "hello"

  eq. ++> can-keep-already-upper-cased-text
    "HELLO"
    locale.up-cased "HELLO"

  eq. ++> can-keep-non-ascii-letters-when-lower-casing
    "ÄÖÜ"
    locale.low-cased "ÄÖÜ"

  eq. ++> can-keep-non-ascii-letters-when-upper-casing
    "äöü"
    locale.up-cased "äöü"
