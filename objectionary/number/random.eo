# Generates a pseudo-random number.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package number
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.63.6

[^num] > random
  num.as-number.div 00-20-00-00-00-00-00-00.as-i64.as-number > @
  [clock] > clocked
    random. > @
      as-number. > [t] >> folded
        plus.
          as-i64.
            and.
              t.left 35
              00-1F-FF-FF-FF-FF-FF-FF
          plus.
            as-i64.
              and.
                t.left 17
                00-00-00-07-FF-FF-FF-FF
            as-i64.
              t.and 00-00-00-00-00-01-FF-FF
      | clock.as-bytes
  random. > [high low] >>
    as-number.
      as-i64.
        and.
          as-bytes.
            plus.
              plus. (high.left 26).as-i64 low
              11.as-i64
          00-1F-FF-FF-FF-FF-FF-FF
  | > next
    and.
      as-bytes.
        times.
          as-i64.
            and. (num.as-i64.div 67108864.as-i64).as-bytes 00-00-00-00-03-FF-FF-FF
          25214903917.as-i64
      00-00-00-00-03-FF-FF-FF
    times.
      as-i64.
        num.as-i64.as-bytes.and 00-00-00-00-03-FF-FF-FF
      25214903917.as-i64
  clocked clock > pseudo

  not. ++> can-differ-between-two-draws
    eq.
      1.random.clocked 123.as-i64
      1.random.clocked 456.as-i64

  0.random.pseudo.lt 1 ++> can-draw-a-clocked-number-below-one

  not. ++> can-reach-the-upper-half
    178609.random.next.lt 0.5

  eq. ++> can-repeat-itself-with-the-same-seed
    1654.random.next.next.next
    1654.random.next.next.next

  ++> can-stay-in-range
    and. > @
      and.
        and.
          rand.lt 1
          not.
            rand.lt 0
        and.
          rand.next.lt 1
          not.
            rand.next.lt 0
      and.
        rand.next.next.lt 1
        not.
          rand.next.next.lt 0
    123.random.next > rand

  ++> can-use-a-seed
    not. > @
      r.next.eq r.next.next
    51.random > r
