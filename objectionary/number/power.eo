# Raises the number to the power of `x` as `org.eolang.number`. A zero exponent
# gives one, an integer exponent is expanded by exponentiation-by-squaring so
# integer results stay exact, and a fractional exponent of a positive base is
# taken as e raised to `x` times the natural logarithm of the base. Zeros,
# infinities and nan follow the same IEEE rules that Math.pow obeys.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package number
+version 0.63.1
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^ x] > power
  if. > @
    eq.
      number x.as-bytes >> expo
      0
    1
    base.is-nan.if
      nan
      expo.is-nan.if
        nan
        expo.is-finite.if
          base.is-finite.if
            if.
              eq.
                number ^.as-bytes >> base
                0
              if.
                and.
                  ^.as-bytes.eq 80-00-00-00-00-00-00-00
                  odd
                if.
                  expo.gt 0
                  0.neg
                  ninf
                if.
                  expo.gt 0
                  0
                  pinf
              expo.is-integer.if
                if.
                  expo.lt 0
                  [^ b n] >> ipow
                    if. > @
                      n.eq 0
                      1
                      if.
                        is-integer. (n.div 2)
                        times.
                          number half
                          number half
                        b.times
                          ^.ipow b (n.minus 1)
                    ^.ipow b (n.div 2) > half!
                  | (1.div base) expo.abs
                  ipow base expo.abs
                if.
                  base.gt 0
                  [^ y] >> expon
                    times. > @
                      if.
                        lt. (number k) 0
                        1.div
                          ipow e (number k).abs
                        ipow e (number k).abs
                      fraction 1
                    y > arg!
                    if. > [^ j] > fraction
                      j.gt 20
                      1
                      1.plus
                        times.
                          div.
                            minus.
                              number ^.arg
                              number ^.k
                            j
                          ^.fraction (j.plus 1)
                    floor. ((number arg).plus 0.5) > k!
                  | (expo.times base.ln)
                  nan
            if.
              base.gt 0
              if.
                expo.gt 0
                pinf
                0
              if.
                expo.gt 0
                if.
                  expo.is-integer.and (expo.div 2).is-integer.not >> odd
                  ninf
                  pinf
                odd.if 0.neg 0
          if.
            expo.gt 0
            if.
              base.abs.gt 1
              pinf
              if.
                base.abs.eq 1
                nan
                0
            if.
              base.abs.gt 1
              0
              if.
                base.abs.eq 1
                nan
                pinf

  gt. ++> can-avoid-underflow-for-a-negative-exponent-that-overflows-positive
    10.power -315
    0

  eq. ++> can-be-called-as-a-method-on-a-number
    2.power 4
    16

  eq. ++> can-be-called-as-a-method-with-a-bound-receiver
    3.power 2
    9

  eq. ++> can-raise-a-float-to-zero
    42.5.power 0
    1

  lt. ++> can-raise-a-fraction-to-a-fraction
    abs.
      minus.
        0.5.power 1.5
        0.35355339059327373
    1.0e-9

  eq. ++> can-raise-a-negative-float-to-negative-infinity
    -42.5.power ninf
    0

  eq. ++> can-raise-a-negative-float-to-positive-infinity
    -4.2.power pinf
    pinf

  eq. ++> can-raise-a-negative-integer-to-negative-infinity
    -42.power ninf
    0

  eq. ++> can-raise-a-negative-integer-to-positive-infinity
    -10.power pinf
    pinf

  eq. ++> can-raise-a-positive-float-to-a-positive-integer
    3.5.power 4
    150.0625

  eq. ++> can-raise-a-positive-float-to-negative-infinity
    42.5.power ninf
    0

  eq. ++> can-raise-a-positive-float-to-positive-infinity
    42.5.power pinf
    pinf

  eq. ++> can-raise-a-positive-integer-to-a-positive-integer
    2.power 3
    8

  eq. ++> can-raise-a-positive-integer-to-negative-infinity
    42.power ninf
    0

  eq. ++> can-raise-a-positive-integer-to-positive-infinity
    42.power pinf
    pinf

  eq. ++> can-raise-a-zero-base
    0.power 145
    0

  eq. ++> can-raise-an-integer-to-zero
    42.power 0
    1

  eq. ++> can-raise-four-to-five
    4.power 5
    1024

  eq. ++> can-raise-four-to-minus-three
    4.power -3
    0.015625

  eq. ++> can-raise-negative-infinity-to-a-positive-float
    ninf.power 9.9
    pinf

  eq. ++> can-raise-negative-infinity-to-an-even-integer
    ninf.power 10
    pinf

  eq. ++> can-raise-negative-infinity-to-an-odd-integer
    ninf.power 9
    ninf

  eq. ++> can-raise-negative-infinity-to-negative-infinity
    ninf.power ninf
    0

  eq. ++> can-raise-negative-zero-to-even-negative
    -0.power -4
    pinf

  eq. ++> can-raise-negative-zero-to-even-positive
    -0.power 4
    0

  eq. ++> can-raise-negative-zero-to-odd-negative
    -0.power -3
    ninf

  eq. ++> can-raise-negative-zero-to-odd-positive
    -0.power 3
