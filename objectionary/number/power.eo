  lt. ++> can-raise-one-to-a-fraction
    abs.
      minus.
        1.power 0.75
        1
    1.0e-9

  eq. ++> can-raise-positive-infinity-to-a-negative-float
    pinf.power -42.2
    0

  eq. ++> can-raise-positive-infinity-to-a-negative-integer
    pinf.power -42
