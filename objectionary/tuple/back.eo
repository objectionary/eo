# Last `index` elements of the tuple (an `index` larger than its `length`
# returns the whole tuple).

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package tuple
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.63.4

[^list index] > back
  index.is-integer.if > @
    if.
      0.gt
        number (list.length.minus index)! >> start
      list
      list.reducedi
        *
        if. > [^list a x i] >>
          i.gte start
          a.with x
          a
    T "Given index must be an integer"

  eq. ++> can-take-a-back-slice
    back.
      *
        1
        2
        3
        4
        5
      2
    *
      4
      5

  eq. ++> can-take-a-back-slice-with-a-large-index
    back.
      *
        1
        2
        3
        4
        5
      10
    *
      1
      2
      3
      4
      5

  is-empty. ++> can-take-a-back-slice-with-a-zero-index
    back.
      *
        1
        2
        3
        4
        5
      0

  back. --> stops-on-a-fractional-index-when-taking-the-back
    *
      "a"
      "b"
    0.5
