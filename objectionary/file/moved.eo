# Moves a file to `target` on the filesystem, returning the file at its new
# location. It is a method of `file`, taken off the file it moves.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package file
+version 0.63.1
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[^ target] > moved
  if. > @
    renamed.code.eq 0
    file target
    T
      "Cant move the file '%s' to '%s': %s".printf
        *
          ^.path
          target
          renamed.output
  called. > renamed
    os.is-windows.if
      win32 *1
        "rename"
        ^.path
        target
      posix *1
        "rename"
        ^.path
        target

  ++> can-move-a-directory
    and. > @
      exists.
        d.as-file.moved
          "%s.dest".printf
            * d
      d.as-file.exists.not
    mktemp.tmpfile.deleted.as-path.as-dir.made.as-path > d

  ++> can-move-a-file
    and. > @
      exists.
        temp.moved
          "%s.dest".printf
            * temp.path
      temp.exists.not
    mktemp.tmpfile > temp

  ++> can-overwrite-an-existing-destination-on-moving
    os.is-windows.or > @
      seq *
        source.open
          "w"
          f.write "first" > [f]
        target.open
          "w"
          f.write "second" > [f]
        source.moved dest
        "first".eq
          malloc.of
            5
            [^ m] >>
              seq * > @
                open.
                  file ^.dest
                  "r"
                  ^.m.put > [^ f] >>
                    f.read 5
                m
    target.path > dest
    mktemp.tmpfile > source
    mktemp.tmpfile > target

  ++> can-preserve-content-after-moving
    seq * > @
      temp.open
        "w"
        f.write > [f]
          "Hello, world"
      temp.moved dest
      "Hello, world".eq
        malloc.of
          12
          [^ m] >>
            seq * > @
              open.
                file ^.dest
                "r"
                ^.m.put > [^ f] >>
                  f.read 12
              m
    "%s.dest".printf > dest
      * temp.path
    mktemp.tmpfile > temp

  mktemp.tmpfile.deleted.moved --> stops-on-moving-an-absent-file
    "irrelevant-target"
