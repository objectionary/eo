    pinf

  eq. ++> can-tell-it-is-not-greater-than-a-float-when-negative-infinity
    ninf.gt 42.5
    false

  eq. ++> can-tell-it-is-not-greater-than-a-larger-integer
    not.
      0.gt 100
    true

