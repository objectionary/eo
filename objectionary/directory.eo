# Directory in the file system.
# Apparently every directory is a file.
#
# A temporary file is named after the clock in milliseconds, the process
# and the microsecond within the current second, so two names asked for
# within one millisecond, as parallel tests do, still differ; Windows has
# no finer clock than a millisecond, so there the last part is derived
# from the clock alone.
#
# @todo #6484:60min Walk a directory in constant stack space. The `stepped`
#  below still costs one frame per entry, because every loop EO has grows the
#  stack: `while` nests a frame per cycle and `tuple.reducedi` one per element,
#  so a directory of a few thousand entries still overflows.
#
# @todo #9541:30min Stop skipping 'redundant-attachment' here. It reads the
#  `>>` name of the fallback `walk` hands to `compile` as unreferenced, since
#  the `^` its head declares masks the hop to `glob` in `walk`, while without
#  the name the walk ends with the bare message of the regex. Remove this
#  directive once objectionary/lints#1301 counts a hop through the receiver
#  as reaching outward.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+version 0.63.6

[file] > directory
  file > @
  [dir time process fraction] > retried
    [^retry index] >> attempted
      if. > @
        descriptor.eq -1
        if.
          errno.eq
            os.is-windows.if win32.eexist posix.eexist
          retry.attempted
            index.plus 1
          T
            "Can't create a unique file in %s: %s".printf
              * retry.dir status.message
        seq *
          retry.closed descriptor
          path
      status.code > descriptor
      os.is-windows.if win32.errno posix.errno > errno
      retry.candidate index > path!
      called. > status
        retry.opened path
    | 0 > @
    [^retry index] > candidate
      path.separator.joined > @
        *
          retry.dir
          "%d-%d-%d-%f".printf >>!
            *
              retry.time
              retry.process
              index
              retry.fraction
    os.is-windows.if > [descriptor] > closed
      win32.close descriptor
      posix.close descriptor
    os.is-windows.if > [name] > opened
      win32.open
        name
        plus.
          win32.rdonly.plus win32.creat
          win32.exclusive
        win32.mode
      posix.open
        name
        plus.
          posix.rdonly.plus posix.creat
          posix.exclusive
        posix.private
  folder.exists.if > [^folder] > tmpfile
    Q.file
      string
        as-bytes.
          folder.retried
            folder.path
            clock.as-number
            os.is-windows.if win32.getpid posix.getpid
            os.is-windows.if
              clock.as-number.random
              posix.gettimeofday.micros.div 1000000
    T
      "Directory %s does not exist, can't create temporary file".printf
        * folder.file
  [^folder glob] > walk
    folder.as-path >> base
    if. > [^folder from] >> closes
      from.gte folder.glob.length
      false
      if.
        eq.
          folder.glob.at
            from
            "" > [x]
          "]"
        true
        folder.closes
          from.plus 1
    if. > [char] >> escaped
      ".+()|^$[]\\".contains char
      "".joined
        * "\\" char
      char
    [^folder index classed] > flags
      folder.glob.at index > char
      classed.not.and > double
        and.
          char.eq "*"
          eq.
            folder.glob.at
              index.plus 1
              "" > [x]
            "*"
      opening.and > negated
        eq.
          folder.glob.at
            index.plus 1
            "" > [x]
          "!"
      classed.not.and > opening
        and.
          char.eq "["
          closes
            index.plus 1
      double.and > slashed
        eq.
          folder.glob.at
            index.plus 2
            "" > [x]
          "/"
    opening.if > [^folder char opening classed] > inside
      true
      if.
        classed.and
          char.eq "]"
        false
        classed
    [^folder text] > matched
      as-bool. > @
        exists.
          next.
            match.
              compile.
                regex.
                  string
                    as-bytes.
                      "".joined
                        *
                          "/^"
                          translated 0 "" false false
                          "$/s"
                T > [^folder x] >>
                  "Can't parse '%s' as a glob pattern, %s".printf
                    * folder.folder.glob x
              text
    if. > [^folder accum rel] > picked
      folder.matched rel
      accum.with
        as-file.
          base.resolved rel
      accum
    if. > [^folder char braced] > plain
      char.eq "["
      T
        "Can't parse '%s' as a glob pattern, Missing ']'".printf
          * folder.glob
      if.
        char.eq "{"
        "("
        if.
          braced.and
            char.eq "}"
          ")"
          if.
            braced.and
              char.eq ","
            "|"
            escaped char
    classed.if > [^folder char braced classed] > rebraced
      braced
      if.
        char.eq "{"
        true
        if.
          char.eq "}"
          false
          braced
    "".joined >> single
      *
        "[^"
        escaped path.separator >> literal
        "]"
    f.slashed.if > [^folder f braced] > starred
      "".joined
        *
          "(?:.*"
          literal
          ")?"
      f.double.if
        ".*"
        folder.symbol f.char braced
    f.slashed.if > [^folder f] > step
      3
      if.
        f.double.or f.negated
        2
        1
    if. > [^folder char braced] > symbol
      char.eq "*"
      "".joined
        * single "*"
      if.
        char.eq "?"
        single
        if.
          char.eq "/"
          literal
          folder.plain char braced
    [^folder index acc braced classed] >> translated
      if. > @
        index.gte folder.glob.length
        braced.if
          T
            "Can't parse '%s' as a glob pattern, Missing '}'".printf
              * folder.glob
          acc
        folder.translated
          index.plus
            folder.step f
          "".joined
            *
              acc
              classed.if
                if.
                  f.char.eq "]"
                  "]"
                  if. > [char] >> classified
                    "\\[&".contains char
                    "".joined
                      * "\\" char
                    char
                  |
                    char.
                      folder.flags index classed >> f
                f.opening.if
                  f.negated.if "[^" "["
                  folder.starred f braced
          folder.rebraced f.char braced classed
          folder.inside f.char f.opening classed
    [^folder dir prefix accum] >> walked
      [^state rest] >> stepped
        if. > @
          rest.length.eq 0
          if.
            state.prefix.length.eq 0
            state.accum
            state.folder.picked state.accum state.prefix
          if.
            and.
              is-directory.
                child.as-file >> entry
                false > [x]
              not.
                entry.is-symlink false
            state.folder.walked
              as-dir.
                state.dir.as-path.resolved rest.head >> child
              if. >> sub
                state.prefix.length.eq 0
                rest.head
                path.separator.joined
                  * state.prefix rest.head
              state.stepped rest.tail >> earlier
            state.folder.picked earlier sub
      | dir.listed > @
    | > @
      folder
      ""
      *

