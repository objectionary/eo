# Sequential execution object that dataizes all provided steps in order
# and returns the value of the final step. All steps are dataized for
# their side effects, while only the last step's value is returned.
# A sequence of no steps has no final step, so it is an error.
#
# The innermost `if` answers the final step on both of its branches on
# purpose: its condition exists only to dataize the steps before it,
# through `bytes.size`, which is total, so it holds for any of them.
#
# Usage example:
# ```
# seq *             # Execute operations sequentially
#   operation1      # Executed for side effects
#   operation2      # Executed for side effects
#   final-value     # Executed and returned
# ```
# .

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT
+unlint same-if-branches
+version 0.63.4

[steps] > seq
  if. > @
    steps.length.eq 0
    T "Can't run a sequence of no steps"
    if.
      steps.length.eq 1
      steps.head
      if.
        gt.
          size.
            dataized
              seq steps.tail
          -1
        steps.head
        steps.head

  eq. ++> can-calculate-and-return
    1
    seq *
      0
      1

  eq. ++> can-calculate-and-return-an-object
    "Hello!"
    seq *
      0
      "Hello!"

  ++> can-dataize-a-float-once-when-greater
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            gt.
              seq *
                x.put
                  x.as-number.plus 1
                x.as-number
              0.9

  ++> can-dataize-a-float-once-when-less
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            lt.
              seq *
                x.put
                  x.as-number.plus 1
                x.as-number
              1.1

  ++> can-dataize-an-integer-once-when-equal
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            eq.
              seq *
                x.put 0
                x.put
                  x.as-number.plus 1
                x.as-number
              1

  ++> can-dataize-an-integer-once-when-equal-and-cached
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            eq.
              seq *
                at.
                  * 0 1
                  x
                x.put
                  x.as-number.plus 1
                x
              1

  ++> can-dataize-an-integer-once-when-less
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            lt.
              seq *
                x.put
                  x.as-number.plus 1
                x.as-number
              2

  ++> can-dataize-an-integer-once-when-less-or-equal
    malloc.of > @
      1
      [b]
        malloc.for > @
          0
          ^.b.put > [^ x] >>
            lte.
              seq *
                x.put
                  x.as-number.plus 1
                x.as-number
              1

  true.eq ++> can-run-a-very-long-sequence
    seq *
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true
      true

  seq --> stops-on-a-sequence-of-no-steps
    *
