          empty.if m shifted
          empty.if
            acc
            acc.or bit
          step.div 2
          bit.right 1
      shifted.eq 00-00-00-00-00-00-00-00 > empty
      m.right step > shifted!
    scan > scanned!
      magnitude
      43-30-00-00-00-00-00-00
      32
      00-00-00-00-00-00-00-20
    ^.as-bytes.and 80-00-00-00-00-00-00-00 > sign!
    not. > sticky
      eq.
        magnitude.left
