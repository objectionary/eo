+unlint sprintf-constant-args
+unlint sprintf-without-formatters
+unlint wrong-sprintf-arguments
+version 0.63.6

[^printf index auto arg] > spec
  as-ascii. > [^owner i] >> code
    string
      byte i
  if. > counter
    25-.eq conv
    auto
    if.
      as-bool.
        and. >> positional!
          gt.
            number dollar
            index.plus 1
          and.
            lt.
              number dollar
              number printf.span
            24-.eq
              slice. > [^owner i] >> byte
                bytes owner.printf.raw
                i
                1
              | (number dollar)
      auto
      auto.plus 1
  if. > [^owner i] >> flags-end
    i.gte
      number owner.printf.span
    i
    if.
      or.
        2D-.eq
          byte i
        30-.eq
          byte i
      owner.flags-end
        i.plus 1
      i
  positional.as-bool.if > idx!
    minus.
      if. > [^owner from to acc] >> digits-value
        from.gte to
        acc
        owner.digits-value
          from.plus 1
          to
          plus.
            acc.times 10
            minus.
              code from
              48
      | (index.plus 1) (number dollar) 0
      1
    auto
  plus. > next
    number end
    1
  if. > piece
    gte.
      number end
      number printf.span
    T
      "The format %s ends with an incomplete specifier, a conversion character is missing".printf
        *
          string printf.raw
    if.
      25-.eq conv
      if.
        eq.
          number end
          index.plus 1
        25-
        T
          "The escaped %% conversion in the format %s does not take flags, width or precision".printf
            *
              string printf.raw
      seq *
        value
        if. >> padded!
          if. > [^format i c] >> flagged
            i.gte
              number digits
            false
            if.
              c.eq
                byte i
              true
              format.flagged
                i.plus 1
                c
          | (number flags) 2D-
          as-bytes.
            padded-right.
              string value
              number width
              " "
              I
          zero.as-bool.if
            as-bytes. >> filled!
              padded-zeros.
                string
                  if. >> value!
                    positional.as-bool.and
                      18.lt
                        minus.
                          number dollar
                          index.plus 1
                    T
                      "The positional argument index in the format %s is too large".printf
                        * (string printf.raw)
                    if.
                      positional.as-bool.and ((number idx).lt 0)
                      T
                        "The positional argument index %d in the format must be 1 or greater".printf
                          * ((number idx).plus 1)
                      if.
                        gte. (number idx) printf.given
                        T
                          "The argument index %d in the format is out of bounds, only %d given".printf
                            * ((number idx).plus 1) printf.given
                        if. >> guarded!
                          precise.as-bool.and (64-.eq conv)
                          T
                            "A precision of %d can't be applied to the %%d conversion".printf
                              * (number precision)
                          if.
                            and.
                              as-bool.
                                flagged (number flags) 30- >> zero!
                              not.
                                or.
                                  64-.eq conv
                                  66-.eq conv
                            T
                              "The zero flag can't be applied to the %s conversion, only to %%d and %%f".printf
                                * (string conv)
                            if. >> converted!
                              73-.eq
                                byte >> conv!
                                  number
                                    precise.as-bool.if >> end!
                                      if. > [^owner i] >> digits-end
                                        i.gte (number owner.printf.span)
                                        i
                                        if.
                                          and.
                                            48.lte (code i)
                                            57.gte (code i)
                                          owner.digits-end (i.plus 1)
                                          i
                                      |
                                        plus.
                                          number
                                            digits-end >> dot!
                                              number
                                                flags-end >> digits!
                                                  number
                                                    positional.as-bool.if >> flags!
                                                      plus.
                                                        number
                                                          digits-end (index.plus 1) >> dollar!
                                                        1
                                                      index.plus 1
                                          1
                                      number dot
                              as-bytes. > [^format text] >> capped
                                precise.as-bool.if
                                  (string text).truncated (number precision) I
                                  text
                              |
                                seq *
                                  length.
                                    string
                                      arg.as-bytes >> datum!
                                  capped (string datum)
                              if.
                                64-.eq conv
                                if.
                                  datum.size.eq 8
                                  as-decimal.
                                    if.
                                      or.
                                        gte.
                                          number
                                            number arg >> numeric!
                                          9.223372036854776e18
                                        lt. (number numeric) -9223372036854775808
                                      T
                                        "The number %s doesn't fit into the long range of the '%%d' conversion".printf
                                          * (string (number numeric).as-scientific)
                                      number numeric
                                  T
                                    "The argument %x is not a number, the %%d conversion takes one".printf
                                      * datum
                                if.
                                  66-.eq conv
                                  if.
                                    datum.size.eq 8
                                    as-fixed.
                                      number numeric
                                      if.
                                        as-bool.
                                          and. >> precise!
                                            lt. (number dot) (number printf.span)
                                            2E-.eq (byte (number dot))
                                        number
                                          precise.as-bool.if >> precision!
                                            digits-value
                                              plus. (number dot) 1
                                              number end
                                              0
                                            0
                                        6
                                    T
                                      "The argument %x is not a number, the %%f conversion takes an eight-byte number".printf
                                        * datum
                                  if.
                                    78-.eq conv
                                    capped (string (bytes datum).as-hex)
                                    if.
                                      62-.eq conv
                                      if.
                                        or. (FF-.eq datum) (00-.eq datum)
                                        capped (datum.as-bool.if "true" "false")
                                        T
                                          "The argument %x is not a boolean, the %%b conversion takes true or false".printf
                                            * datum
                                      T
                                        "The conversion %s in the format is unsupported, only %%s, %%d, %%f, %%x and %%b are".printf
                                          * (string conv)
                number
                  digits-value >> width!
                    number digits
                    number dot
                    0
                I
            as-bytes.
              padded-left.
                string value
                number width
                " "
                I

