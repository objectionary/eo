# Returns the `text` in upper case.

+alias tuple.reduced
+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+version 0.62.1
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[text] > up-cased
  string > @
    tuple.reduced
      text.as-bytes.array
      --
      [accum byte] >>
        accum.concat > @
          if.
            and.
              code.lte (as-ascii "z")!
              code.gte mincode
            slice.
              as-bytes.
                as-i64.
                  code.minus
                    minus.
                      number mincode
                      as-ascii "A"
              7
              1
            byte
        as-ascii byte > code
  as-ascii "a" >> mincode!

  eq. ++> can-convert-already-upper-cased-text
    "HELLO"
    up-cased "HeLlO"

  eq. ++> can-convert-text-to-upper-case
    "HELLO"
    up-cased "hello"
