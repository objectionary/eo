# Returns the `text` in lower case.

+alias tuple.reduced
+architect yegor256@gmail.com
+home https://github.com/objectionary/eo
+package string
+version 0.62.1
+spdx SPDX-FileCopyrightText: Copyright (c) 2016-2026 Objectionary.com
+spdx SPDX-License-Identifier: MIT

[text] > low-cased
  string > @
    tuple.reduced
      text.as-bytes.array
      --
      [accum byte] >>
        accum.concat > @
          if.
            and.
              code.lte
                as-ascii "Z"
              code.gte
                as-ascii "A"
            slice.
              as-bytes.
                as-i64.
                  code.plus
                    minus.
                      as-ascii "a"
                      as-ascii "A"
              7
              1
            byte
        as-ascii byte > code

  eq. ++> can-convert-already-lower-cased-text
    "hello"
    low-cased "HeLlO"

  eq. ++> can-convert-text-to-lower-case
    "hello"
    low-cased "HELLO"
