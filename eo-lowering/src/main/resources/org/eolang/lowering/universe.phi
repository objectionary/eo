⟦
  number ↦ ⟦
    as-bytes ↦ ∅,
    φ ↦ ξ.as-bytes,
    div ↦ ⟦ x ↦ ∅, λ ⤍ L_number_div ⟧,
    gt ↦ ⟦ x ↦ ∅, λ ⤍ L_number_gt ⟧,
    plus ↦ ⟦ x ↦ ∅, λ ⤍ L_number_plus ⟧,
    times ↦ ⟦ x ↦ ∅, λ ⤍ L_number_times ⟧
  ⟧,
  string ↦ ⟦
    as-bytes ↦ ∅,
    φ ↦ ξ.as-bytes,
    slice ↦ ⟦ start ↦ ∅, len ↦ ∅, λ ⤍ L_string_slice ⟧
  ⟧,
  bytes ↦ ⟦
    data ↦ ∅,
    φ ↦ ξ.data,
    and ↦ ⟦ b ↦ ∅, λ ⤍ L_bytes_and ⟧,
    concat ↦ ⟦ b ↦ ∅, λ ⤍ L_bytes_concat ⟧,
    eq ↦ ⟦ b ↦ ∅, λ ⤍ L_bytes_eq ⟧,
    not ↦ ⟦ λ ⤍ L_bytes_not ⟧,
    or ↦ ⟦ b ↦ ∅, λ ⤍ L_bytes_or ⟧,
    right ↦ ⟦ x ↦ ∅, λ ⤍ L_bytes_right ⟧,
    size ↦ ⟦ λ ⤍ L_bytes_size ⟧,
    slice ↦ ⟦ start ↦ ∅, len ↦ ∅, cant-slice ↦ ∅, λ ⤍ L_bytes_slice ⟧
  ⟧,
  bool ↦ ⟦
    as-bytes ↦ ∅,
    φ ↦ ξ.as-bytes,
    if ↦ ⟦ t ↦ ∅, f ↦ ∅, λ ⤍ L_bool_if ⟧
  ⟧,
  tuple ↦ ⟦
    self ↦ ∅,
    length ↦ ⟦ λ ⤍ L_tuple_length ⟧,
    at ↦ ⟦ i ↦ ∅, λ ⤍ L_tuple_at ⟧
  ⟧,
  object ↦ ⟦
    self ↦ ∅,
    as-bytes ↦ ⟦ λ ⤍ L_object_as_bytes ⟧
  ⟧,
  true ↦ Φ.bool(α0 ↦ Φ.bytes(α0 ↦ ⟦ Δ ⤍ FF- ⟧)),
  false ↦ Φ.bool(α0 ↦ Φ.bytes(α0 ↦ ⟦ Δ ⤍ 00- ⟧))
⟧
